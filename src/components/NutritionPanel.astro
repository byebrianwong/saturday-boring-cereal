---
import { grams, milligrams, percent, plain } from '../lib/format';
import { per100g, percentDV, type Nutrition } from '../lib/nutrition';
import { proteinDVOf } from '../lib/score';

interface Props {
  /** Per serving, as stored. */
  nutrition: Nutrition;
  /**
   * '100g' (default) scales to 100 g for fair comparison. 'serving' shows the
   * stored numbers as the label prints them, for checking against a label photo.
   */
  basis?: '100g' | 'serving';
}

const { nutrition: label, basis = '100g' } = Astro.props;
const perServing = basis === 'serving';
const n = perServing ? label : per100g(label);
const servingText = label.servingDescription
  ? `${label.servingDescription} (${label.servingSize} g)`
  : `${label.servingSize} g`;

// %DV column, laid out like a US label: blank for nutrients with no Daily Value.
const dv = (v: number | null) => (v == null ? '' : percent(v));
const protein = proteinDVOf(n);
const proteinDVText =
  protein.dv == null ? '' : protein.estimated ? `~${percent(protein.dv)}` : percent(protein.dv);

const rows: Array<{
  label: string;
  value: string;
  dv: string;
  /** 0 = top-level nutrient, 1 = indented, 2 = "Includes … Added Sugars". */
  level?: 1 | 2;
  bold?: boolean;
}> = [
  { label: 'Total Fat', value: grams(n.totalFat), dv: dv(percentDV('totalFat', n.totalFat)), bold: true },
  { label: 'Saturated Fat', value: grams(n.saturatedFat), dv: dv(percentDV('saturatedFat', n.saturatedFat)), level: 1 },
  { label: 'Trans Fat', value: grams(n.transFat), dv: '', level: 1 },
  { label: 'Polyunsaturated Fat', value: grams(n.polyunsaturatedFat), dv: '', level: 1 },
  { label: 'Monounsaturated Fat', value: grams(n.monounsaturatedFat), dv: '', level: 1 },
  { label: 'Sodium', value: milligrams(n.sodium), dv: dv(percentDV('sodium', n.sodium)), bold: true },
  { label: 'Total Carbohydrate', value: grams(n.totalCarbs), dv: dv(percentDV('totalCarbs', n.totalCarbs)), bold: true },
  { label: 'Dietary Fiber', value: grams(n.dietaryFiber), dv: dv(percentDV('dietaryFiber', n.dietaryFiber)), level: 1 },
  { label: 'Total Sugars', value: grams(n.totalSugars), dv: '', level: 1 },
  { label: 'Added Sugars', value: grams(n.addedSugars), dv: dv(percentDV('addedSugars', n.addedSugars)), level: 2 },
  { label: 'Protein', value: grams(n.protein), dv: proteinDVText, bold: true },
];
---

<div class="nf">
  <h3>Nutrition Facts</h3>
  <div class="basis">
    <span>Amount per</span>
    <span>{perServing ? `serving: ${servingText}` : '100 g'}</span>
  </div>
  <div class="rule-8"></div>
  <div class="calories">
    <span>Calories</span>
    <span class:list={['v', { missing: n.calories == null }]}>{plain(n.calories)}</span>
  </div>
  <div class="dvhead">% Daily Value*</div>
  {
    rows.map((r) => {
      const missing = r.value === 'not listed';
      return (
        <div class:list={['row', `l${r.level ?? 0}`, { bold: r.bold }]}>
          <span>
            {r.level === 2 && !missing ? (
              <>
                Includes <span class="v">{r.value}</span> {r.label}
              </>
            ) : (
              <>
                <span class="name">{r.label}</span>{' '}
                <span class:list={['v', { missing }]}>{r.value}</span>
              </>
            )}
          </span>
          <span class="dv">{r.dv}</span>
        </div>
      );
    })
  }
  <p class="foot">
    * % Daily Value: how much of the FDA's daily amount, on a 2,000-calorie diet, is in
    {perServing ? 'one serving' : '100 g'}. No % means the nutrient has no Daily Value. ~ means
    estimated from grams.
  </p>
  {perServing ? (
    <p class="foot">
      The stored numbers for one serving, before scaling to 100 g. They should match the label
      photo line for line.
    </p>
  ) : (
    <p class="foot">
      Scaled from the box's own label serving of {servingText}, so every box is compared at the
      same weight.
    </p>
  )}
</div>

<style>
  .nf {
    background: #fff;
    color: #000;
    font-family: var(--fine);
    border: 2px solid #000;
    padding: 14px 16px;
  }

  h3 {
    font-size: 30px;
    font-weight: 900;
    letter-spacing: -1px;
    border-bottom: 1px solid #000;
    padding-bottom: 4px;
  }

  .basis {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 16px;
    font-weight: 900;
    padding: 6px 0 4px;
  }

  .rule-8 {
    border-bottom: 9px solid #000;
    margin-bottom: 4px;
  }

  .foot {
    font-size: 10px;
    line-height: 1.4;
    color: #444;
    padding-top: 6px;
    margin-top: 3px;
    border-top: 3px solid #000;
  }

  .foot + .foot {
    border-top: 0;
    margin-top: 0;
    padding-top: 4px;
  }

  .calories {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 22px;
    font-weight: 900;
    padding: 2px 0 4px;
    border-bottom: 4px solid #000;
  }

  .dvhead {
    text-align: right;
    font-size: 11px;
    font-weight: 900;
    padding: 4px 0;
    border-bottom: 1px solid #000;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    padding: 5px 0;
    border-bottom: 1px solid #000;
  }

  .row.bold .name {
    font-weight: 900;
  }

  .row.l1 {
    padding-left: 18px;
    font-size: 12px;
  }

  .row.l2 {
    padding-left: 36px;
    font-size: 12px;
  }

  .dv {
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .missing {
    color: #999;
    font-style: italic;
  }

  .v {
    font-variant-numeric: tabular-nums;
  }
</style>
