---
import { tierColor, overallOutOfTen } from '../lib/score';

interface Props {
  tier: string | null;
  overall: number | null;
}

const { tier, overall } = Astro.props;
const color = tier == null ? 'na' : tierColor(tier);
const out10 = overall == null ? null : overallOutOfTen(overall);
---

<div class:list={['stamp', color]} title={overall == null ? 'Unrated overall' : `Overall ${out10} / 10`}>
  <span class="cap">Tier</span>
  <span class="letter">{tier ?? '—'}</span>
  <span class="num">{out10 ? `${out10} / 10` : 'unrated'}</span>
</div>

<style>
  .stamp {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    line-height: 1;
    width: 118px;
    height: 118px;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, color-mix(in srgb, var(--seal) 88%, #fff), var(--seal) 55%, var(--seal-dark));
    border: 3px solid #fff;
    box-shadow: 0 0 0 3px var(--seal-dark), 0 8px 18px rgba(0, 0, 0, 0.28);
    transform: rotate(-7deg);
    padding: 6px;
  }

  /* --- colour by tier --- */
  .stamp.elite {
    --seal: var(--turq);
    --seal-dark: var(--turq-deep);
  }
  .stamp.good {
    --seal: var(--score-good);
    --seal-dark: var(--score-good-dark);
  }
  .stamp.mid {
    --seal: var(--score-mid);
    --seal-dark: var(--score-mid-dark);
  }
  .stamp.bad {
    --seal: var(--score-bad);
    --seal-dark: var(--score-bad-dark);
  }
  .stamp.na {
    --seal: #9aa0a6;
    --seal-dark: #7c8186;
  }

  .stamp .cap {
    font-family: var(--fine);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .stamp .letter {
    font-family: var(--shout);
    font-size: 52px;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.3);
    margin: 1px 0 2px;
  }

  .stamp .num {
    font-family: var(--fine);
    font-size: 11px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    opacity: 0.95;
  }
</style>
