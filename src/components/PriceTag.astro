---
import { rating as fmtRating } from '../lib/format';
import { healthOutOfTen } from '../lib/score';

interface Props {
  rating: number | null;
  macros: string;
  /** The 0–100 Health score. With no Taste score to show, the tag shows this instead. */
  health?: number | null;
}

const { rating, macros, health } = Astro.props;
---

<div class="ptag">
  <div class:list={['p', { unrated: rating == null }]}>
    {rating != null ? (
      <>{fmtRating(rating)}<small>/10</small></>
    ) : health != null ? (
      <>{healthOutOfTen(health)}<small>/10 health</small></>
    ) : (
      <>—<small>unrated</small></>
    )}
  </div>
  <!-- Macros stay deliberately plain: the one thing on the card that never
       exaggerates. Named .mline, not .macros — the latter is the global card
       macro strip and would style this as a yellow three-up flex row. -->
  <div class="mline">{macros}</div>
</div>

<style>
  .ptag {
    background: var(--white);
    border: 3px solid var(--ink);
    border-top: 0;
    text-align: center;
    padding: 5px 4px 5px;
  }

  .p {
    font-family: var(--shout);
    font-size: 22px;
    line-height: 1;
    color: var(--cherry);
  }

  .p small {
    font-family: var(--fine);
    font-size: 9px;
    color: var(--muted);
    margin-left: 1px;
  }

  .p.unrated { color: var(--muted); }
  .p.unrated small { font-size: 8px; letter-spacing: 0.1em; text-transform: uppercase; }

  .mline {
    font-family: var(--fine);
    font-size: 9px;
    line-height: 1.35;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin-top: 3px;
  }
</style>
