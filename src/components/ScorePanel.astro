---
import type { CollectionEntry } from 'astro:content';
import { scoreCereal, scoreTier, TASTE_WEIGHT, type Subscore } from '../lib/score';
import TierStamp from './TierStamp.astro';
import { u } from '../lib/url';

interface Props {
  cereal: CollectionEntry<'cereals'>;
}

const { cereal } = Astro.props;
const score = scoreCereal(cereal);

// Taste is half the overall score on its own, so it gets its own row above the
// four nutrition bars, which share the other half between them.
const taste = score.subscores.find((s) => s.key === 'taste')!;
const nutrition = score.subscores.filter((s) => s.key !== 'taste');
const tastePct = Math.round(TASTE_WEIGHT * 100);
const tierOf = (s: Subscore) => (s.score == null ? 'na' : scoreTier(s.score));
---

<section class="verdict">
  <div class="head">
    <span class="sticker">The Verdict</span>
  </div>

  <div class="grid">
    <div class="stamp-cell">
      <TierStamp tier={score.tier} overall={score.overall} />
    </div>

    <div class="bars">
      <div class:list={['sub', 'taste', tierOf(taste)]}>
        <div class="lab">
          <span class="name">{taste.label} <span class="share">{tastePct}% of the score</span></span>
          <span class:list={['det', { missing: taste.score == null }]}>{taste.detail}</span>
        </div>
        <div class="track">
          {taste.score != null && <div class="fill" style={`width: ${Math.max(taste.score, 3)}%`} />}
        </div>
      </div>

      <div class="group">
        <div class="grouphead">Nutrition <span class="share">{100 - tastePct}% of the score</span></div>
        {
          nutrition.map((s) => (
            <div class:list={['sub', tierOf(s)]}>
              <div class="lab">
                <span class="name">{s.label}</span>
                <span class:list={['det', { missing: s.score == null }]}>{s.detail}</span>
              </div>
              <div class="track">
                {s.score != null && <div class="fill" style={`width: ${Math.max(s.score, 3)}%`} />}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <p class="fine">
    <a href={u('/about/#overall')}>How scoring works →</a>
  </p>
</section>

<style>
  .verdict {
    background: #fffdf4;
    border: 2px solid var(--ink);
    border-radius: 10px;
    box-shadow: 0 6px 0 rgba(91, 58, 30, 0.18);
    padding: 16px 18px 14px;
  }

  .head {
    margin-bottom: 14px;
  }

  .grid {
    display: grid;
    grid-template-columns: 118px 1fr;
    gap: 20px;
    align-items: center;
  }

  .stamp-cell {
    display: flex;
    justify-content: center;
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding-top: 12px;
    border-top: 1px dashed #d8cba8;
  }

  .grouphead {
    font-family: var(--fine);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .share {
    margin-left: 4px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--muted);
  }

  .lab {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .name {
    font-family: var(--fine);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .det {
    font-family: var(--fine);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .det.missing {
    font-weight: 400;
    font-style: italic;
    color: #a99;
    text-transform: none;
  }

  .track {
    position: relative;
    height: 10px;
    background: var(--cream);
    border-radius: 999px;
    overflow: hidden;
  }

  /* The nutrition bars are thinner than Taste, which counts as much as all four together. */
  .group .track {
    height: 7px;
  }

  .taste .name {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }

  .taste .name .share {
    font-size: 11px;
  }

  .taste .det {
    font-size: 15px;
  }

  .taste .track {
    height: 16px;
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 999px;
    min-width: 6px;
  }

  .sub.good .fill {
    background: linear-gradient(90deg, color-mix(in srgb, var(--score-good) 78%, #fff), var(--score-good));
  }
  .sub.mid .fill {
    background: linear-gradient(90deg, color-mix(in srgb, var(--score-mid) 80%, #fff), var(--score-mid));
  }
  .sub.bad .fill {
    background: linear-gradient(90deg, color-mix(in srgb, var(--score-bad) 82%, #fff), var(--score-bad));
  }

  .fine {
    margin-top: 14px;
    padding-top: 11px;
    border-top: 1px dashed #d8cba8;
    font-family: var(--fine);
    font-size: 12px;
    line-height: 1.5;
    color: #7a6a4a;
  }

  .fine a {
    color: var(--turq-deep);
  }

  @media (max-width: 420px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .stamp-cell {
      justify-content: flex-start;
    }
  }
</style>
