---
import { u } from '../lib/url';

interface Props {
  /** How many cereals are on the shelf. Shown in the ticker. */
  count: number;
  /** The current page's path, so its nav button shows as pressed. */
  path: string;
}

const { count, path } = Astro.props;

const nav = [
  { href: '/cereals/', label: 'The Aisle' },
  { href: '/top/', label: 'Rankings' },
  { href: '/compare/', label: 'Price Check' },
  { href: '/reviews/', label: 'Receipts' },
  { href: '/about/', label: 'Store Policy' },
];
---

<div class="ticker">
  <div class="ticker-inner">
    {[0, 1].map(() => (
      <>
        <span>★ We interrupt your cartoons ★</span>
        <span><b>As seen Saturday mornings</b></span>
        <span>★ {count} boxes reviewed ★</span>
        <span><b>Now fortified with opinions</b></span>
        <span>★ Offer ends Saturday ★</span>
      </>
    ))}
  </div>
</div>

<header class="site">
  <div class="wrap">
    <a class="brandline" href={u('/')}>
      <span class="a">Saturday</span> <span class="b">Boring</span> <span class="c">Cereal</span>
    </a>
    <div class="brand-sub">One man · One aisle · One box at a time</div>
    <nav class="site">
      {nav.map((item) => (
        <a href={u(item.href)} class:list={{ on: path.startsWith(u(item.href)) }}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  header.site {
    background: var(--white);
    border-bottom: 5px solid var(--ink);
    padding: 16px 0 14px;
    text-align: center;
    position: relative;
    z-index: 6;
  }

  .brandline {
    display: block;
    font-family: var(--shout);
    font-size: clamp(24px, 4vw, 34px);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--ink);
  }

  .brandline .a { color: var(--orange); }
  .brandline .b { color: var(--turq); }
  .brandline .c { color: var(--cherry); }

  .brand-sub {
    font-family: var(--fine);
    font-size: 11px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: #8a7a63;
    margin-top: 7px;
  }

  nav.site {
    margin-top: 14px;
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  nav.site a {
    font-family: var(--shout);
    font-size: 17px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 8px 18px 6px;
    border: 3px solid var(--ink);
    background: var(--white);
    box-shadow: 3px 3px 0 var(--ink);
    transition: transform 0.08s, box-shadow 0.08s;
  }

  /* Fixed colour per nav slot — the row reads as a strip of ad buttons. */
  nav.site a:nth-child(1) { background: var(--yellow); }
  nav.site a:nth-child(2) { background: var(--orange); color: var(--white); }
  nav.site a:nth-child(3) { background: var(--turq); color: var(--white); }
  nav.site a:nth-child(4) { background: var(--yellow); }
  nav.site a:nth-child(5) { background: var(--cherry); color: var(--white); }

  nav.site a:hover { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }

  /* Current page presses in and stays pressed. */
  nav.site a.on {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--ink);
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  /* Phones: the header was eating a third of the screen. Drop the tagline and
     run the nav as one short row that scrolls sideways instead of wrapping. */
  @media (max-width: 640px) {
    header.site { padding: 10px 0 0; border-bottom-width: 4px; }
    .brandline { font-size: 22px; }
    .brand-sub { display: none; }

    nav.site {
      margin: 8px -18px 0;
      padding: 0 18px 10px;
      gap: 6px;
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav.site::-webkit-scrollbar { display: none; }

    nav.site a {
      flex: none;
      font-size: 13px;
      padding: 5px 10px 4px;
      border-width: 2px;
      box-shadow: 2px 2px 0 var(--ink);
    }

    nav.site a.on {
      transform: translate(2px, 2px);
      outline-width: 2px;
    }
  }
</style>
