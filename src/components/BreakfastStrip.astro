---
// "Part of a complete breakfast": the line old cereal adverts ran under a
// picture of the meal. Here the meal is just bowl, cereal, milk and spoon.
---

<div class="breakfast-strip">
  <div class="bl">Part of a complete breakfast</div>

  <div class="bfoods">
    <figure>
      <svg width="52" height="42" viewBox="0 0 52 42" aria-hidden="true">
        <path d="M4 15h44c0 13-9 22-22 22S4 28 4 15z" fill="#12b5c9" stroke="#1b1206" stroke-width="3" />
        <ellipse cx="26" cy="15" rx="22" ry="5" fill="#fff" stroke="#1b1206" stroke-width="3" />
      </svg>
      <figcaption>Bowl</figcaption>
    </figure>

    <span class="plus" aria-hidden="true">+</span>

    <figure>
      <svg width="40" height="46" viewBox="0 0 40 46" aria-hidden="true">
        <rect x="6" y="3" width="28" height="40" fill="#ff9d2e" stroke="#1b1206" stroke-width="3" />
        <rect x="10" y="9" width="20" height="8" fill="#ffcf24" stroke="#1b1206" stroke-width="2" />
        <circle cx="15" cy="27" r="4" fill="none" stroke="#1b1206" stroke-width="2.4" />
        <circle cx="25" cy="30" r="4" fill="none" stroke="#1b1206" stroke-width="2.4" />
        <circle cx="18" cy="36" r="3.5" fill="none" stroke="#1b1206" stroke-width="2.4" />
      </svg>
      <figcaption>Cereal</figcaption>
    </figure>

    <span class="plus" aria-hidden="true">+</span>

    <figure>
      <svg width="36" height="46" viewBox="0 0 36 46" aria-hidden="true">
        <path d="M7 14l5-10h12l5 10v29H7z" fill="#ffffff" stroke="#1b1206" stroke-width="3" stroke-linejoin="round" />
        <path d="M7 14h22" stroke="#1b1206" stroke-width="3" />
        <rect x="10" y="22" width="16" height="11" fill="#12b5c9" />
      </svg>
      <figcaption>Milk</figcaption>
    </figure>

    <span class="plus" aria-hidden="true">+</span>

    <figure>
      <svg width="22" height="46" viewBox="0 0 22 46" aria-hidden="true">
        <rect x="8.5" y="18" width="5" height="25" rx="2.5" fill="#ffffff" stroke="#1b1206" stroke-width="3" />
        <ellipse cx="11" cy="11" rx="8" ry="9" fill="#ffffff" stroke="#1b1206" stroke-width="3" />
      </svg>
      <figcaption>Spoon</figcaption>
    </figure>
  </div>
</div>

<style>
  .breakfast-strip {
    position: relative;
    z-index: 4;
    background: var(--white);
    border-top: 5px solid var(--ink);
    padding: 14px 0 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .bl {
    font-family: var(--shout);
    font-size: clamp(16px, 2vw, 26px);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .bfoods { display: flex; align-items: center; gap: 12px; }
  .bfoods figure { margin: 0; text-align: center; }

  .plus {
    font-family: var(--shout);
    font-size: 30px;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 14px;
  }

  .bfoods figcaption {
    font-family: var(--fine);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9a8b74;
    margin-top: 3px;
  }
</style>
