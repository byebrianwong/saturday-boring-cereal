---
// "Part of this complete breakfast" — the disclaimer every cereal advert ran
// under a table of food the cereal had nothing to do with. The punchline is the
// second label: we only grade the bowl.
---

<div class="breakfast-strip">
  <div class="bl">Part of this complete breakfast</div>

  <div class="bfoods">
    <figure>
      <svg width="46" height="42" viewBox="0 0 46 42" aria-hidden="true">
        <path d="M8 14c0-6 6-10 15-10s15 4 15 10v20a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4z" fill="#f0b96a" stroke="#1b1206" stroke-width="3" />
        <path d="M13 17h20v8H13z" fill="#e01b1b" opacity=".18" />
      </svg>
      <figcaption>Toast</figcaption>
    </figure>

    <figure>
      <svg width="38" height="46" viewBox="0 0 38 46" aria-hidden="true">
        <path d="M8 8h22l-3 34H11z" fill="#ff9d2e" stroke="#1b1206" stroke-width="3" />
        <path d="M9.5 15h19l-.6 7h-17.8z" fill="#ffcf24" />
        <rect x="24" y="1" width="5" height="16" rx="2" fill="#12b5c9" stroke="#1b1206" stroke-width="2.4" />
      </svg>
      <figcaption>Juice</figcaption>
    </figure>

    <figure>
      <svg width="36" height="46" viewBox="0 0 36 46" aria-hidden="true">
        <path d="M7 6h22l-3 36H10z" fill="#ffffff" stroke="#1b1206" stroke-width="3" />
        <path d="M8.3 16h19.4l-2.2 25H10.5z" fill="#eef3f6" />
      </svg>
      <figcaption>Milk</figcaption>
    </figure>

    <figure>
      <svg width="40" height="44" viewBox="0 0 40 44" aria-hidden="true">
        <ellipse cx="20" cy="24" rx="15" ry="17" fill="#fff" stroke="#1b1206" stroke-width="3" />
        <circle cx="20" cy="25" r="7" fill="#ffcf24" stroke="#1b1206" stroke-width="2.4" />
      </svg>
      <figcaption>Egg</figcaption>
    </figure>

    <figure>
      <svg width="46" height="42" viewBox="0 0 46 42" aria-hidden="true">
        <path d="M6 10c2 18 14 26 32 25 3-1 4-4 1-5C22 27 14 19 12 8c-1-4-6-3-6 2z" fill="#ffcf24" stroke="#1b1206" stroke-width="3" />
      </svg>
      <figcaption>Banana</figcaption>
    </figure>

    <figure>
      <svg width="52" height="42" viewBox="0 0 52 42" aria-hidden="true">
        <path d="M5 15h34c0 12-7 19-17 19S5 27 5 15z" fill="#12b5c9" stroke="#1b1206" stroke-width="3" />
        <path d="M39 18c6-5 10-1 7 4-2 4-7 6-9 5" fill="none" stroke="#1b1206" stroke-width="3" />
        <ellipse cx="22" cy="15" rx="17" ry="5" fill="#fff" stroke="#1b1206" stroke-width="3" />
      </svg>
      <figcaption>The bowl</figcaption>
    </figure>
  </div>

  <div class="bl">(We only grade the bowl)</div>
</div>

<style>
  .breakfast-strip {
    position: relative;
    z-index: 4;
    background: var(--white);
    border-top: 5px solid var(--ink);
    padding: 14px 0 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .bl {
    font-family: var(--shout);
    font-size: clamp(16px, 2vw, 26px);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .bfoods { display: flex; align-items: flex-end; gap: 16px; }
  .bfoods figure { margin: 0; text-align: center; }

  .bfoods figcaption {
    font-family: var(--fine);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9a8b74;
    margin-top: 3px;
  }
</style>
