---
// A single product face in a grid. Was a little 3D box standing on a shelf;
// now it's a flat ad card — hard border, offset shadow, presses in on hover.
interface Props {
  emoji: string;
  brand: string;
  name: string;
  boxColor: string;
  href?: string;
  boxImage?: string;
}

import { u } from '../lib/url';

const { emoji, brand, name, boxColor, href, boxImage } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="mini" href={href ? u(href) : undefined} style={`--bc: ${boxColor}`}>
  <div class:list={['mf', { hasphoto: boxImage }]}>
    {
      boxImage ? (
        <img class="photo" src={u(boxImage)} alt={`${brand} ${name}`} loading="lazy" />
      ) : (
        <>
          <div class="em">{emoji}</div>
          <div class="mb">{brand}</div>
          <h5>{name}</h5>
        </>
      )
    }
  </div>
</Tag>

<style>
  .mini {
    position: relative;
    width: 118px;
    height: 158px;
    display: block;
    text-decoration: none;
    border: 3px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    background: var(--white);
    transition: transform 0.08s, box-shadow 0.08s;
  }

  a.mini:hover {
    transform: translate(3px, 3px);
    box-shadow: 2px 2px 0 var(--ink);
  }

  .mf {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6px;
    background: var(--bc);
    overflow: hidden;
  }

  .mf.hasphoto { padding: 0; background: var(--white); }

  .photo { width: 100%; height: 100%; object-fit: cover; }

  .em { font-size: 34px; line-height: 1; }

  .mb {
    font-family: var(--fine);
    font-size: 7px;
    letter-spacing: 0.14em;
    color: #fff;
    background: rgba(0, 0, 0, 0.42);
    padding: 2px 6px;
    margin-top: 6px;
    text-transform: uppercase;
  }

  h5 {
    font-size: 10px;
    color: #fff;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.45);
    margin-top: 4px;
    line-height: 1.15;
    font-family: var(--shout);
    text-transform: uppercase;
  }
</style>
