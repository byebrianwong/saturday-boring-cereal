---
import type { CollectionEntry } from 'astro:content';
import { u } from '../lib/url';
import { inWrapper, productPath } from '../lib/taxonomy';
import WrapperShot from './WrapperShot.astro';
import { scoreCereal, overallOutOfTen, tierColor } from '../lib/score';
import { cardMacros } from '../lib/macros';

interface Props {
  cereal: CollectionEntry<'cereals'>;
  rank: number;
  /** Tier 2 cards are wider; tier 3 fill the lower rows. */
  size?: 'big' | 'sm';
}

const { cereal, rank, size = 'sm' } = Astro.props;
const d = cereal.data;

// Only values the label actually lists. The tint is a quiet hint of good,
// middling or poor; the number itself stays plain.
const macros = cardMacros(cereal);

// The sticker leads with the Tier letter, not the score. A 5.9 and a 5.8 are
// the same for anyone choosing a box; the letter says which group it is in.
// The score (taste and health combined) stays on as small print.
const { overall, tier } = scoreCereal(cereal);
---

<a class={`cd ${size}`} href={u(productPath(cereal))}>
  <span class="rank-chip">{rank}</span>

  <span class:list={['score starburst', tier == null ? 'unrated' : `tier-${tierColor(tier)}`]}>
    <span class="sc">Tier</span>
    <span class="sv">{tier ?? '—'}</span>
    <span class="so">{overall == null ? 'Unrated' : `${overallOutOfTen(overall)} / 10`}</span>
  </span>

  <span class="box">
    {inWrapper(cereal) ? (
      <WrapperShot
        image={d.boxImage}
        emoji={d.emoji}
        boxColor={d.boxColor}
        alt={`${d.brand} ${d.name} wrapper`}
        note="No image on file"
      />
    ) : d.boxImage ? (
      <img src={u(d.boxImage)} alt={`${d.brand} ${d.name} box`} loading="lazy" />
    ) : (
      <span class="fallback" style={`background:${d.boxColor}`}>
        <span class="em">{d.emoji}</span>
        <span class="lb">No image on file</span>
      </span>
    )}
  </span>

  <span class="brand">{d.brand}</span>
  <span class="name">{d.name}</span>

  <span class="macros">
    {macros.map((m) => (
      <span class={`t-${m.tier}`} title={`${m.verdict}, by the Tier score's cut-offs`}>
        <span class="mv">{m.value}</span>
        <span class="mk">{m.label}</span>
        <span class="sr-only">({m.verdict})</span>
      </span>
    ))}
  </span>
</a>

<style>
  .cd {
    display: block;
    transition: transform 0.08s, box-shadow 0.08s;
  }

  .cd:hover {
    transform: translate(3px, 3px);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .cd .brand,
  .cd .name { display: block; }

  .macros { display: flex; }
  .macros > span { flex: 1; padding: 7px 2px 6px; border-right: 3px solid var(--ink); }
  .macros > span:last-child { border-right: 0; }
  .macros .mv,
  .macros .mk { display: block; }

  .score { text-align: center; }
  .score .sc,
  .score .sv,
  .score .so { display: block; }
  .score.unrated { background: var(--muted); }

  /* ---- tier 2 ---- */
  .cd.big { width: 400px; }
  .cd.big .box { height: 236px; }
  .cd.big .name { font-size: 31px; min-height: 56px; }
  .cd.big .score { width: 118px; height: 118px; right: -26px; top: -26px; }
  .cd.big .score .sc { font-size: 9px; }
  .cd.big .score .sv { font-size: 54px; }
  .cd.big .score .so { font-size: 9px; margin-top: 2px; }

  /* ---- tier 3 ---- */
  .cd.sm { width: 340px; }
  .cd.sm .box { height: 180px; }
  .cd.sm .name { font-size: 24px; min-height: 44px; }
  .cd.sm .score { width: 96px; height: 96px; right: -20px; top: -20px; }
  .cd.sm .score .sc { font-size: 8px; }
  .cd.sm .score .sv { font-size: 44px; }
  .cd.sm .score .so { font-size: 8px; margin-top: 1px; }
  .cd.sm .rank-chip { width: 46px; height: 46px; font-size: 23px; top: -16px; left: -16px; }
  .cd.sm .macros .mv { font-size: 20px; }

  @media (max-width: 860px) {
    .cd.big,
    .cd.sm { width: min(340px, 88vw); }
  }
</style>
