---
import { u } from '../lib/url';
---

<footer class="site">
  <div class="wrap">
    <div class="fbrand">Saturday Boring Cereal</div>
    <div class="fjoke">Now fortified with opinions</div>
    <nav>
      <a href={u('/cereals/')}>The Aisle</a>
      <a href={u('/top/')}>Rankings</a>
      <a href={u('/compare/')}>Price Check</a>
      <a href={u('/reviews/')}>Receipts</a>
      <a href={u('/about/')}>Store Policy</a>
      <a href={u('/rss.xml')}>RSS</a>
    </nav>
    <div class="foot-rule"></div>
    <div class="fine">
      A single-person regulatory body · Established in a kitchen<br />
      No sponsors. No samples. No mascots.
    </div>
  </div>
</footer>

<style>
  footer.site {
    background: var(--ink);
    color: var(--cream);
    padding: 44px 0 34px;
    text-align: center;
    border-top: 6px solid var(--ink);
  }

  .fbrand {
    font-family: var(--shout);
    font-size: clamp(28px, 5vw, 44px);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--yellow);
    line-height: 1;
  }

  .fjoke {
    font-family: var(--fine);
    font-size: 13px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--turq);
    margin-top: 10px;
  }

  footer nav {
    margin: 24px 0 0;
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  footer nav a {
    font-family: var(--shout);
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 7px 15px 5px;
    border: 2px solid #5a4c36;
    color: var(--cream);
  }

  footer nav a:hover { background: var(--yellow); color: var(--ink); border-color: var(--yellow); }

  .foot-rule {
    max-width: 1080px;
    height: 3px;
    background: #3d3221;
    margin: 28px auto 0;
  }

  footer .fine {
    margin-top: 20px;
    font-family: var(--fine);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8d7f68;
    line-height: 1.7;
  }
</style>
