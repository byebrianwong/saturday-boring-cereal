---
import { AISLE_FILTERS, EVERYTHING_FILTERS, label, type Category } from '../lib/taxonomy';
import { u } from '../lib/url';

interface Props {
  /** 'links' renders anchors to the explorer; 'buttons' renders client-side filter buttons. */
  mode?: 'links' | 'buttons';
  active?: string;
  /** Whose filters to show. 'all' is the short row used when every category is on the shelf. */
  category?: Category | 'all';
  /** Rendered but hidden, for the explorer's other categories. */
  hidden?: boolean;
  /** Keep only these filter keys, e.g. the ones some product in stock carries. */
  only?: string[];
}

const { mode = 'links', active = 'all', category = 'cereal', hidden = false, only } = Astro.props;
const all = category === 'all' ? EVERYTHING_FILTERS : AISLE_FILTERS[category];
const filters = only ? all.filter((k) => only.includes(k)) : all;

// Explorer links carry the category in the hash next to the filter. Cereal is
// the explorer's default, so a cereal link leaves it out: /cereals/#f=granola.
function href(key: string): string {
  const parts = [];
  if (category !== 'cereal') parts.push(`c=${category}`);
  if (key !== 'all') parts.push(`f=${key}`);
  return u(parts.length ? `/cereals/#${parts.join('&')}` : '/cereals/');
}
---

<div
  class="aisles"
  data-filter-bar={mode === 'buttons' ? category : undefined}
  hidden={hidden}
>
  {
    filters.map((key, i) =>
      mode === 'links' ? (
        <a href={href(key)} class:list={{ on: key === active }}>
          <small>AISLE {i + 1}</small>
          {label(key)}
        </a>
      ) : (
        <button type="button" data-filter={key} class:list={{ on: key === active }}>
          <small>AISLE {i + 1}</small>
          {label(key)}
        </button>
      )
    )
  }
</div>

<style>
  /* Was a row of hanging supermarket aisle signs; now a strip of ad buttons.
     Class names and the data-filter hooks are unchanged — the filter script on
     /cereals/ selects on [data-filter-bar="<category>"] [data-filter]. */
  .aisles {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 34px 0 8px;
  }

  .aisles[hidden] { display: none; }

  .aisles a,
  .aisles button {
    font-family: var(--shout);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    border: 3px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    cursor: pointer;
    font-size: 14px;
    letter-spacing: 0.08em;
    padding: 8px 15px 6px;
    text-transform: uppercase;
    transition: transform 0.08s, box-shadow 0.08s;
    line-height: 1.05;
  }

  .aisles a:hover,
  .aisles button:hover {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  .aisles a.on,
  .aisles button.on {
    background: var(--cherry);
    color: var(--white);
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--ink);
  }

  .aisles small {
    display: block;
    font-family: var(--fine);
    font-size: 8px;
    letter-spacing: 0.2em;
    color: var(--muted);
    margin-bottom: 2px;
  }

  .aisles a.on small,
  .aisles button.on small { color: rgba(255, 255, 255, 0.8); }
</style>
