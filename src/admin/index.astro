---
// The stock room: `npm run find` with a browser on it.
//
// Injected as a route only during `astro dev` (see astro.config.mjs), because it
// needs server routes and a writable src/content/cereals — neither of which
// exists in a static build on a static host. It never ships in dist/.
import Layout from '../layouts/Layout.astro';
import { readTaxonomy } from '../../scripts/lib/enrich-core.mjs';
import { isAuthed, usingDefaultPassword } from './lib/auth';

export const prerender = false;

const authed = isAuthed(Astro.request);
const defaultPassword = usingDefaultPassword();
const { FORM_FACTORS, PROTEIN_SOURCES, ATTRIBUTES } = readTaxonomy();

// Mirror Keystatic's labels so the two admin surfaces read the same.
const label = (v: string) =>
  v === 'os' ? "O's" : v.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(v.includes('-') ? '-' : ' ');
---

<Layout title="Stock Room — Saturday Boring Cereal">
  <div class="sign">
    <strong>STOCK ROOM</strong>
    <small>STAFF ONLY · GOODS INWARD · DEV SERVER ONLY</small>
  </div>

  {!authed && (
    <form class="gate" id="gate">
      <h2>Password</h2>
      <input type="password" id="pw" autocomplete="current-password" autofocus />
      <button type="submit">Clock in</button>
      <p class="err" id="gate-err" hidden></p>
      {defaultPassword && (
        <p class="hint">
          No <code>ADMIN_PASSWORD</code> set, so it's <code>cereal</code>. Set one in
          <code>.env</code> to change it.
        </p>
      )}
    </form>
  )}

  {authed && (
    <div class="admin" id="admin">
      <div class="tabs" role="tablist">
        <button type="button" class="tab on" id="tab-add" role="tab">Add a cereal</button>
        <button type="button" class="tab" id="tab-edit" role="tab">Edit one you have</button>
      </div>

      <!-- ============================ EDIT ============================ -->
      <section id="pane-edit" hidden>
        <input type="search" id="filter" placeholder="Filter the aisle…" />
        <p class="status" id="edit-status"></p>
        <div id="catalog" class="catalog"></div>

        <form class="compose" id="editor" hidden>
          <div class="picked" id="editing"></div>

          <div class="grid">
            <label>Brand<input type="text" id="e-brand" required /></label>
            <label>Product name<input type="text" id="e-name" required /></label>
            <label>Taste score <span class="sub">0–10, blank = unrated</span>
              <input type="number" id="e-rating" min="0" max="10" step="0.1" />
            </label>
            <label>Emoji <span class="sub">used when there's no photo</span>
              <input type="text" id="e-emoji" maxlength="4" />
            </label>
            <label>Box colour <span class="sub">behind the emoji</span>
              <input type="text" id="e-boxColor" />
            </label>
          </div>
          <label class="full">Tasting note
            <input type="text" id="e-note" placeholder="One line. Blank removes it." />
          </label>

          <fieldset>
            <legend>Tags</legend>
            <div class="tags">
              <div><h4>Form</h4>{FORM_FACTORS?.map((v: string) => (
                <label class="chk"><input type="checkbox" name="e-form" value={v} /> {label(v)}</label>
              ))}</div>
              <div><h4>Protein</h4>{PROTEIN_SOURCES?.map((v: string) => (
                <label class="chk"><input type="checkbox" name="e-protein-src" value={v} /> {label(v)}</label>
              ))}</div>
              <div><h4>Attributes</h4>{ATTRIBUTES?.map((v: string) => (
                <label class="chk"><input type="checkbox" name="e-attr" value={v} /> {label(v)}</label>
              ))}</div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Nutrition <span class="sub">per serving · blank means “not listed”</span></legend>
            <p class="note">
              Leave a field blank when the box doesn't print it — the site says “not listed”
              rather than inventing a number. That goes double for protein %DV, which labels
              only carry when a protein claim is made.
            </p>
            <div class="nutgrid" id="nutgrid"></div>
          </fieldset>

          <fieldset>
            <legend>Box photo</legend>
            <div class="photo-now" id="photo-now"></div>
            <div class="actions left">
              <button type="button" class="secondary" id="find-photos">Find photos</button>
              <button type="button" class="secondary danger" id="drop-photo">Remove photo</button>
            </div>
            <p class="status" id="photo-status"></p>
            <div class="gallery" id="e-gallery"></div>
            <div class="imgrow">
              <label class="full">Or paste an image URL
                <input type="url" id="e-imgurl" placeholder="https://…/front.png" />
              </label>
              <label>Fit
                <select id="e-fit">
                  <option value="cover">cover — crop to fill</option>
                  <option value="contain">contain — pad onto white</option>
                </select>
              </label>
            </div>
          </fieldset>

          <div class="actions">
            <button type="button" id="e-preview-btn" class="secondary">Preview changes</button>
            <button type="submit" id="e-save-btn">Save changes</button>
          </div>
          <p class="err" id="edit-err" hidden></p>
        </form>

        <pre class="preview" id="e-preview" hidden></pre>
        <div class="done" id="e-done" hidden></div>
      </section>

      <!-- ============================ ADD ============================= -->
      <section id="pane-add">
      <!-- 1. search -->
      <form class="search" id="search">
        <input
          type="search"
          id="q"
          placeholder="Search a cereal by name — e.g. kodiak cookie butter"
          autofocus
        />
        <button type="submit" id="search-btn">Search</button>
        <label class="usda"><input type="checkbox" id="usda" checked /> include USDA</label>
      </form>
      <p class="status" id="status"></p>

      <!-- 2. pick a product -->
      <div id="results" class="results"></div>

      <!-- 3. everything else -->
      <form class="compose" id="compose" hidden>
        <h2>2 · Write it up</h2>
        <div class="picked" id="picked"></div>

        <div class="grid">
          <label>Brand<input type="text" id="brand" required /></label>
          <label>Product name<input type="text" id="name" required /></label>
          <label>Taste score <span class="sub">0–10, blank = unrated</span>
            <input type="number" id="rating" min="0" max="10" step="0.1" />
          </label>
          <label>Emoji <span class="sub">box art placeholder</span>
            <input type="text" id="emoji" value="🥣" maxlength="4" />
          </label>
        </div>
        <label class="full">Tasting note
          <input type="text" id="note" placeholder="One line. What it actually tastes like." />
        </label>

        <fieldset>
          <legend>Tags <span class="sub">guessed from the name and ingredients — fix what's wrong</span></legend>
          <div class="tags">
            <div><h4>Form</h4>{FORM_FACTORS?.map((v: string) => (
              <label class="chk"><input type="checkbox" name="form" value={v} /> {label(v)}</label>
            ))}</div>
            <div><h4>Protein</h4>{PROTEIN_SOURCES?.map((v: string) => (
              <label class="chk"><input type="checkbox" name="protein-src" value={v} /> {label(v)}</label>
            ))}</div>
            <div><h4>Attributes</h4>{ATTRIBUTES?.map((v: string) => (
              <label class="chk"><input type="checkbox" name="attr" value={v} /> {label(v)}</label>
            ))}</div>
          </div>
        </fieldset>

        <fieldset>
          <legend>Box photo <span class="sub">pick the flattest, most straight-on front</span></legend>
          <p class="note">
            These render as the front face of a 3D box that already rotates itself, so an
            angled or hand-held shot reads as a box inside a box. If none of these are
            flat, paste a manufacturer URL below or skip it — the emoji placeholder is
            better than a bad photo.
          </p>
          <div class="gallery" id="gallery"></div>
          <div class="imgrow">
            <label class="full">Or paste an image URL
              <input type="url" id="imgurl" placeholder="https://…/front.png" />
            </label>
            <label>Fit
              <select id="fit">
                <option value="cover">cover — crop to fill</option>
                <option value="contain">contain — pad onto white</option>
              </select>
            </label>
          </div>
        </fieldset>

        <div class="actions">
          <button type="button" id="preview-btn" class="secondary">Preview file</button>
          <button type="submit" id="save-btn">Add to the aisle</button>
        </div>
        <p class="err" id="compose-err" hidden></p>
      </form>

      <pre class="preview" id="preview" hidden></pre>
      <div class="done" id="done" hidden></div>
      </section>
    </div>
  )}
</Layout>

<script>
  // --- login ------------------------------------------------------------------
  const gate = document.getElementById('gate') as HTMLFormElement | null;
  gate?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('gate-err')!;
    const res = await fetch('/admin/api/login', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ password: (document.getElementById('pw') as HTMLInputElement).value }),
    });
    if (res.ok) return location.reload();
    err.textContent = (await res.json().catch(() => ({}))).error || 'Wrong password.';
    err.hidden = false;
  });

  // --- state ------------------------------------------------------------------
  const admin = document.getElementById('admin');
  if (admin) {
    let candidates: any[] = [];
    let images: { url: string; from: string }[] = [];
    let picked: any = null;
    let chosenImage: string | null = null;

    const $ = (id: string) => document.getElementById(id)!;
    const statusEl = $('status');
    const resultsEl = $('results');
    const composeEl = $('compose') as HTMLFormElement;
    const galleryEl = $('gallery');
    const previewEl = $('preview');
    const doneEl = $('done');

    const esc = (s: unknown) =>
      String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const g = (v: any, unit = 'g') => (v == null ? '—' : `${v}${unit}`);

    // --- 1. search ------------------------------------------------------------
    $('search').addEventListener('submit', async (e) => {
      e.preventDefault();
      const query = ($('q') as HTMLInputElement).value.trim();
      if (!query) return;

      resultsEl.innerHTML = '';
      composeEl.hidden = true;
      previewEl.hidden = true;
      doneEl.hidden = true;
      statusEl.textContent = 'Searching…';
      ($('search-btn') as HTMLButtonElement).disabled = true;

      let data: any;
      try {
        const res = await fetch('/admin/api/search', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ query, useUsda: ($('usda') as HTMLInputElement).checked }),
        });
        data = await res.json();
        if (!res.ok) throw new Error(data.error || `Search failed (${res.status})`);
      } catch (err: any) {
        statusEl.textContent = err.message;
        return;
      } finally {
        ($('search-btn') as HTMLButtonElement).disabled = false;
      }

      candidates = data.candidates || [];
      images = data.images || [];

      if (!candidates.length) {
        statusEl.textContent = data.allSourcesFailed
          ? 'Every source errored, so this says nothing about whether the product is listed. Check your connection and try again.'
          : 'Nothing matched. Try fewer words — brand plus one flavour word works best. Small and store brands are often missing from both databases; those need `npm run add`.';
        return;
      }

      statusEl.textContent =
        `${candidates.length} result${candidates.length === 1 ? '' : 's'}` +
        (data.errors?.length ? ` · ${data.errors.join(' · ')}` : '');

      resultsEl.innerHTML = `<h2>1 · Which one is it?</h2>` + candidates.map((c) => `
        <button type="button" class="hit${c.usable && !c.exists ? '' : ' off'}" data-i="${c.index}"
          ${c.usable && !c.exists ? '' : 'disabled'}>
          <div class="hit-name">${esc(c.matchedBrand ? c.matchedBrand + ' — ' : '')}${esc(c.matchedName)}</div>
          <div class="hit-tags">
            ${esc(c.sourceLabel)}${c.alsoIn ? ` · +${esc(c.alsoIn)}` : ''}
            ${c.imageCount ? ` · ${c.imageCount} photo${c.imageCount === 1 ? '' : 's'}` : ''}
            ${c.exists ? ' · <b>already in the aisle</b>' : ''}
            ${!c.usable ? ' · <b>no serving size — unusable</b>' : ''}
          </div>
          <div class="hit-macros">
            ${c.servingSize ? c.servingSize + 'g serving' : 'serving size not listed'} ·
            ${g(c.calories, ' kcal')} · ${g(c.protein)} protein ·
            ${g(c.totalSugars)} sugar · ${g(c.dietaryFiber)} fiber
          </div>
        </button>`).join('');

      resultsEl.querySelectorAll('.hit').forEach((el) =>
        el.addEventListener('click', () => choose(Number((el as HTMLElement).dataset.i))));
    });

    // --- 2. pick --------------------------------------------------------------
    function choose(i: number) {
      picked = candidates.find((c) => c.index === i);
      if (!picked) return;

      resultsEl.querySelectorAll('.hit').forEach((el) =>
        el.classList.toggle('on', Number((el as HTMLElement).dataset.i) === i));

      ($('brand') as HTMLInputElement).value = picked.brand;
      ($('name') as HTMLInputElement).value = picked.name;

      for (const [group, values] of [
        ['form', picked.tags?.formFactors],
        ['protein-src', picked.tags?.proteinSources],
        ['attr', picked.tags?.attributes],
      ] as [string, string[] | undefined][]) {
        composeEl.querySelectorAll(`input[name="${group}"]`).forEach((el) => {
          (el as HTMLInputElement).checked = !!values?.includes((el as HTMLInputElement).value);
        });
      }

      $('picked').innerHTML =
        `Filling from <b>${esc(picked.sourceLabel)}</b>: “${esc(picked.matchedName)}” ` +
        `· <a href="${esc(picked.url)}" target="_blank" rel="noreferrer">check the source</a>` +
        `<br><span class="sub">${picked.servingSize}g serving · ${g(picked.calories, ' kcal')} · ` +
        `${g(picked.protein)} protein · ${g(picked.totalSugars)} sugar · ` +
        `${g(picked.dietaryFiber)} fiber · ${g(picked.sodium, 'mg')} sodium</span>`;

      // Default to this product's own photo when it has one.
      chosenImage = picked.raw?.image ?? null;
      renderGallery();

      composeEl.hidden = false;
      previewEl.hidden = true;
      doneEl.hidden = true;
      composeEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // --- 3. image picker ------------------------------------------------------
    function renderGallery() {
      if (!images.length) {
        galleryEl.innerHTML = '<p class="none">No photos on any of the matching records — paste one below, or skip and keep the emoji placeholder.</p>';
        return;
      }
      galleryEl.innerHTML =
        `<button type="button" class="shot none-shot${chosenImage ? '' : ' on'}" data-url="">
           <span>No photo</span><small>keep the emoji</small>
         </button>` +
        images.map((img) => `
          <button type="button" class="shot${chosenImage === img.url ? ' on' : ''}" data-url="${esc(img.url)}">
            <img src="${esc(img.url)}" alt="" loading="lazy" />
            <small>${esc(img.from)}</small>
          </button>`).join('');

      galleryEl.querySelectorAll('.shot').forEach((el) =>
        el.addEventListener('click', () => {
          chosenImage = (el as HTMLElement).dataset.url || null;
          if (chosenImage) ($('imgurl') as HTMLInputElement).value = '';
          renderGallery();
        }));
    }

    // A pasted URL wins over the gallery.
    $('imgurl').addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value.trim();
      if (v) {
        chosenImage = v;
        galleryEl.querySelectorAll('.shot').forEach((el) => el.classList.remove('on'));
      }
    });

    // --- 4. save --------------------------------------------------------------
    function payload(dryRun: boolean) {
      const checked = (group: string) =>
        [...composeEl.querySelectorAll(`input[name="${group}"]:checked`)].map((el) => (el as HTMLInputElement).value);
      const pasted = ($('imgurl') as HTMLInputElement).value.trim();
      const url = pasted || chosenImage;
      return {
        candidate: picked.raw,
        brand: ($('brand') as HTMLInputElement).value,
        name: ($('name') as HTMLInputElement).value,
        rating: ($('rating') as HTMLInputElement).value,
        note: ($('note') as HTMLInputElement).value,
        emoji: ($('emoji') as HTMLInputElement).value,
        formFactors: checked('form'),
        proteinSources: checked('protein-src'),
        attributes: checked('attr'),
        imageUrl: url,
        // A pasted URL is yours, not Open Food Facts' — credit it accordingly.
        imageSource: url && url === pasted ? 'manufacturer' : 'open_food_facts',
        fit: ($('fit') as HTMLSelectElement).value,
        dryRun,
      };
    }

    async function submit(dryRun: boolean) {
      const err = $('compose-err');
      err.hidden = true;
      const btn = dryRun ? ($('preview-btn') as HTMLButtonElement) : ($('save-btn') as HTMLButtonElement);
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = dryRun ? 'Building…' : 'Writing…';

      let data: any;
      try {
        const res = await fetch('/admin/api/create', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload(dryRun)),
        });
        data = await res.json();
        if (!res.ok) throw new Error(data.error || `Failed (${res.status})`);
      } catch (e: any) {
        err.textContent = e.message;
        err.hidden = false;
        return;
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }

      if (dryRun) {
        previewEl.textContent = data.markdown;
        previewEl.hidden = false;
        previewEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      const img = data.image;
      doneEl.innerHTML =
        `<h2>✓ Added <code>${esc(data.slug)}.md</code></h2>` +
        `<p>${data.filled} nutrition fields from ${esc(data.sourceLabel)}` +
        `${data.basis === 'label' ? ' (printed label)' : ''}: “${esc(data.matchedName)}”.` +
        (data.blank?.length ? ` Still blank: ${esc(data.blank.join(', '))} — renders as “not listed”.` : '') + `</p>` +
        (data.dropped?.length
          ? `<p class="warn">Dropped as implausible: ${esc(data.dropped.join(' · '))}</p>` : '') +
        (data.imageError
          ? `<p class="warn">Photo failed: ${esc(data.imageError)} — the emoji placeholder stays.</p>` : '') +
        (img
          ? `<p>Photo: ${img.width}×${img.height} → trimmed ${img.trimmedWidth}×${img.trimmedHeight} → 900×1200, ${(img.bytes / 1024).toFixed(0)}KB.` +
            (img.lostPct >= 25 ? ` <span class="warn">The crop discarded ~${img.lostPct}% off the ${esc(img.lostAxis)} — try “contain” instead.</span>` : '') + `</p>` : '') +
        `<p><a href="/cereals/${esc(data.slug)}/" target="_blank" rel="noreferrer">Open its page →</a> ` +
        `· <a href="/keystatic/collection/cereals/item/${esc(data.slug)}" target="_blank" rel="noreferrer">Edit in Keystatic →</a></p>` +
        `<p class="sub">It's a file on disk now: commit it when you're happy.</p>`;
      doneEl.hidden = false;
      composeEl.hidden = true;
      previewEl.hidden = true;
      // The slug it just took is no longer available.
      const used = candidates.find((c) => c.index === picked.index);
      if (used) used.exists = true;
      doneEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    $('preview-btn').addEventListener('click', () => submit(true));
    composeEl.addEventListener('submit', (e) => {
      e.preventDefault();
      submit(false);
    });

    // ======================= EDIT AN EXISTING CEREAL =======================
    const NUTRITION_FIELDS: [string, string, string][] = [
      ['servingSize', 'Serving size', 'g'],
      ['servingDescription', 'Serving description', ''],
      ['calories', 'Calories', 'kcal'],
      ['totalFat', 'Total fat', 'g'],
      ['saturatedFat', 'Saturated fat', 'g'],
      ['transFat', 'Trans fat', 'g'],
      ['polyunsaturatedFat', 'Polyunsaturated fat', 'g'],
      ['monounsaturatedFat', 'Monounsaturated fat', 'g'],
      ['totalCarbs', 'Total carbs', 'g'],
      ['dietaryFiber', 'Dietary fiber', 'g'],
      ['totalSugars', 'Total sugars', 'g'],
      ['addedSugars', 'Added sugars', 'g'],
      ['protein', 'Protein', 'g'],
      ['proteinDV', 'Protein %DV', '%'],
      ['sodium', 'Sodium', 'mg'],
    ];

    let catalog: any[] = [];
    let editing: any = null;
    let editImage: string | null = null;
    let dropPhoto = false;

    const editorEl = $('editor') as HTMLFormElement;
    const catalogEl = $('catalog');
    const eGalleryEl = $('e-gallery');

    // --- tabs -----------------------------------------------------------------
    function showTab(which: 'add' | 'edit') {
      $('tab-add').classList.toggle('on', which === 'add');
      $('tab-edit').classList.toggle('on', which === 'edit');
      ($('pane-add') as HTMLElement).hidden = which !== 'add';
      ($('pane-edit') as HTMLElement).hidden = which !== 'edit';
      if (which === 'edit' && !catalog.length) loadCatalog();
    }
    $('tab-add').addEventListener('click', () => showTab('add'));
    $('tab-edit').addEventListener('click', () => showTab('edit'));

    // --- the catalog ----------------------------------------------------------
    async function loadCatalog() {
      $('edit-status').textContent = 'Loading the aisle…';
      try {
        const res = await fetch('/admin/api/list');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not list the cereals.');
        catalog = data.cereals || [];
        $('edit-status').textContent = `${catalog.length} in the aisle.`;
        renderCatalog();
      } catch (e: any) {
        $('edit-status').textContent = e.message;
      }
    }

    function renderCatalog() {
      const q = ($('filter') as HTMLInputElement).value.trim().toLowerCase();
      const shown = q
        ? catalog.filter((c) => `${c.brand} ${c.name} ${c.slug}`.toLowerCase().includes(q))
        : catalog;
      catalogEl.innerHTML = shown.map((c) => `
        <button type="button" class="row${editing?.slug === c.slug ? ' on' : ''}" data-slug="${esc(c.slug)}">
          <span class="row-thumb">${c.boxImage
            ? `<img src="${esc(c.boxImage)}" alt="" loading="lazy" />`
            : `<span class="row-emoji">${esc(c.emoji)}</span>`}</span>
          <span class="row-text">
            <b>${esc(c.brand)}</b> ${esc(c.name)}
            <small>${c.rating == null ? 'unrated' : c.rating + '/10'} · ${esc(c.slug)}${
              c.dateUpdated ? ` · updated ${esc(c.dateUpdated)}` : ''}</small>
          </span>
        </button>`).join('') || '<p class="none">Nothing matches that filter.</p>';

      catalogEl.querySelectorAll('.row').forEach((el) =>
        el.addEventListener('click', () => openCereal((el as HTMLElement).dataset.slug!)));
    }
    $('filter').addEventListener('input', renderCatalog);

    // --- load one into the form ----------------------------------------------
    async function openCereal(slug: string) {
      $('edit-err').hidden = true;
      ($('e-preview') as HTMLElement).hidden = true;
      ($('e-done') as HTMLElement).hidden = true;
      $('photo-status').textContent = '';
      eGalleryEl.innerHTML = '';
      editImage = null;
      dropPhoto = false;

      let data: any;
      try {
        const res = await fetch('/admin/api/load', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug }),
        });
        data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not load it.');
      } catch (e: any) {
        $('edit-status').textContent = e.message;
        return;
      }

      editing = { slug, ...data.cereal };
      renderCatalog();

      const c = data.cereal;
      ($('e-brand') as HTMLInputElement).value = c.brand ?? '';
      ($('e-name') as HTMLInputElement).value = c.name ?? '';
      ($('e-rating') as HTMLInputElement).value = c.rating == null ? '' : String(c.rating);
      ($('e-note') as HTMLInputElement).value = c.shortNote ?? '';
      ($('e-emoji') as HTMLInputElement).value = c.emoji ?? '🥣';
      ($('e-boxColor') as HTMLInputElement).value = c.boxColor ?? '';
      ($('e-imgurl') as HTMLInputElement).value = '';

      for (const [group, values] of [
        ['e-form', c.formFactors],
        ['e-protein-src', c.proteinSources],
        ['e-attr', c.attributes],
      ] as [string, string[] | undefined][]) {
        editorEl.querySelectorAll(`input[name="${group}"]`).forEach((el) => {
          (el as HTMLInputElement).checked = !!values?.includes((el as HTMLInputElement).value);
        });
      }

      $('nutgrid').innerHTML = NUTRITION_FIELDS.map(([key, lbl, unit]) => {
        const v = c.nutrition?.[key];
        const isText = key === 'servingDescription';
        return `<label>${esc(lbl)}${unit ? ` <span class="sub">${esc(unit)}</span>` : ''}
          <input type="${isText ? 'text' : 'number'}" step="any" id="n-${key}"
                 value="${v == null ? '' : esc(v)}" placeholder="${isText ? '' : 'not listed'}" />
        </label>`;
      }).join('');

      $('editing').innerHTML =
        `Editing <code>${esc(slug)}.md</code>` +
        ` · <a href="/cereals/${esc(slug)}/" target="_blank" rel="noreferrer">see the page</a>` +
        `<br><span class="sub">The filename and URL stay as they are — renaming the brand or ` +
        `product here only changes how it reads on the site.</span>`;

      renderPhotoNow();
      editorEl.hidden = false;
      editorEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // --- photo ---------------------------------------------------------------
    function renderPhotoNow() {
      const current = editing?.boxImage;
      if (dropPhoto) {
        $('photo-now').innerHTML =
          `<p class="warn">Photo will be removed on save, and <code>noAutoImage</code> set so ` +
          `enrichment can't put an angled one back. The ${esc(($('e-emoji') as HTMLInputElement).value)} placeholder takes over.</p>`;
        return;
      }
      $('photo-now').innerHTML = current
        ? `<img class="now" src="${esc(current)}" alt="" /><span class="sub">Current photo${
            editing.imageSource ? ` · ${esc(editing.imageSource)}` : ''}</span>`
        : `<p class="none">No photo — showing the ${esc(editing?.emoji ?? '🥣')} placeholder.${
            editing?.noAutoImage ? ' Marked <code>noAutoImage</code>.' : ''}</p>`;
    }

    $('drop-photo').addEventListener('click', () => {
      dropPhoto = !dropPhoto;
      if (dropPhoto) {
        editImage = null;
        ($('e-imgurl') as HTMLInputElement).value = '';
        eGalleryEl.querySelectorAll('.shot').forEach((el) => el.classList.remove('on'));
      }
      ($('drop-photo') as HTMLButtonElement).textContent = dropPhoto ? 'Keep the photo' : 'Remove photo';
      renderPhotoNow();
    });

    // Reuses the same search the add flow uses — just for its image pool.
    $('find-photos').addEventListener('click', async () => {
      const btn = $('find-photos') as HTMLButtonElement;
      const query = `${($('e-brand') as HTMLInputElement).value} ${($('e-name') as HTMLInputElement).value}`.trim();
      btn.disabled = true;
      $('photo-status').textContent = `Looking for photos of “${query}”…`;
      try {
        const res = await fetch('/admin/api/search', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ query, useUsda: false }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Search failed.');
        const found = data.images || [];
        $('photo-status').textContent = found.length
          ? `${found.length} photo${found.length === 1 ? '' : 's'} found — pick one, or keep what you have.`
          : 'No photos on any matching record. Paste a URL instead.';
        eGalleryEl.innerHTML = found.map((img: any) => `
          <button type="button" class="shot" data-url="${esc(img.url)}">
            <img src="${esc(img.url)}" alt="" loading="lazy" />
            <small>${esc(img.from)}</small>
          </button>`).join('');
        eGalleryEl.querySelectorAll('.shot').forEach((el) =>
          el.addEventListener('click', () => {
            editImage = (el as HTMLElement).dataset.url || null;
            dropPhoto = false;
            ($('drop-photo') as HTMLButtonElement).textContent = 'Remove photo';
            ($('e-imgurl') as HTMLInputElement).value = '';
            eGalleryEl.querySelectorAll('.shot').forEach((s) => s.classList.remove('on'));
            el.classList.add('on');
            renderPhotoNow();
          }));
      } catch (e: any) {
        $('photo-status').textContent = e.message;
      } finally {
        btn.disabled = false;
      }
    });

    $('e-imgurl').addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value.trim();
      if (v) {
        editImage = v;
        dropPhoto = false;
        ($('drop-photo') as HTMLButtonElement).textContent = 'Remove photo';
        eGalleryEl.querySelectorAll('.shot').forEach((el) => el.classList.remove('on'));
        renderPhotoNow();
      }
    });

    // --- save ----------------------------------------------------------------
    function editPayload(dryRun: boolean) {
      const checked = (group: string) =>
        [...editorEl.querySelectorAll(`input[name="${group}"]:checked`)].map((el) => (el as HTMLInputElement).value);
      const nutrition: Record<string, string> = {};
      for (const [key] of NUTRITION_FIELDS) {
        nutrition[key] = ($(`n-${key}`) as HTMLInputElement).value;
      }
      const pasted = ($('e-imgurl') as HTMLInputElement).value.trim();
      return {
        slug: editing.slug,
        fields: {
          brand: ($('e-brand') as HTMLInputElement).value,
          name: ($('e-name') as HTMLInputElement).value,
          rating: ($('e-rating') as HTMLInputElement).value,
          shortNote: ($('e-note') as HTMLInputElement).value,
          emoji: ($('e-emoji') as HTMLInputElement).value,
          boxColor: ($('e-boxColor') as HTMLInputElement).value,
          formFactors: checked('e-form'),
          proteinSources: checked('e-protein-src'),
          attributes: checked('e-attr'),
        },
        nutrition,
        imageUrl: dropPhoto ? null : pasted || editImage,
        removeImage: dropPhoto,
        fit: ($('e-fit') as HTMLSelectElement).value,
        dryRun,
      };
    }

    async function saveEdit(dryRun: boolean) {
      const err = $('edit-err');
      err.hidden = true;
      const btn = dryRun ? ($('e-preview-btn') as HTMLButtonElement) : ($('e-save-btn') as HTMLButtonElement);
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = dryRun ? 'Building…' : 'Saving…';

      let data: any;
      try {
        const res = await fetch('/admin/api/update', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(editPayload(dryRun)),
        });
        data = await res.json();
        if (!res.ok) throw new Error(data.error || `Failed (${res.status})`);
      } catch (e: any) {
        err.textContent = e.message;
        err.hidden = false;
        return;
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }

      if (data.unchanged) {
        err.textContent = 'Nothing changed — the file is already exactly this.';
        err.hidden = false;
        return;
      }

      if (dryRun) {
        ($('e-preview') as HTMLElement).textContent = data.markdown;
        ($('e-preview') as HTMLElement).hidden = false;
        ($('e-preview') as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      const img = data.image;
      $('e-done').innerHTML =
        `<h2>✓ Saved <code>${esc(data.slug)}.md</code></h2>` +
        `<p>Changed: ${esc((data.changed || []).join(', ')) || 'the photo only'}.</p>` +
        (data.imageError ? `<p class="warn">Photo failed: ${esc(data.imageError)} — the old one stays.</p>` : '') +
        (img
          ? `<p>New photo: ${img.width}×${img.height} → trimmed ${img.trimmedWidth}×${img.trimmedHeight} → 900×1200, ${(img.bytes / 1024).toFixed(0)}KB.` +
            (img.lostPct >= 25 ? ` <span class="warn">The crop discarded ~${img.lostPct}% off the ${esc(img.lostAxis)} — try “contain”.</span>` : '') + `</p>`
          : '') +
        `<p><a href="/cereals/${esc(data.slug)}/" target="_blank" rel="noreferrer">Open its page →</a></p>` +
        `<p class="sub">Written to disk — <code>git diff</code> to see it, then commit.</p>`;
      ($('e-done') as HTMLElement).hidden = false;
      ($('e-preview') as HTMLElement).hidden = true;
      editorEl.hidden = true;
      editing = null;
      loadCatalog();
      ($('e-done') as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    $('e-preview-btn').addEventListener('click', () => saveEdit(true));
    editorEl.addEventListener('submit', (e) => {
      e.preventDefault();
      saveEdit(false);
    });
  }
</script>

<style>
