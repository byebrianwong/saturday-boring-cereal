---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { shortDate } from '../lib/format';

const cereals = await getCollection('cereals');
const newestFirst = [...cereals].sort(
  (a, b) => b.data.dateReviewed.getTime() - a.data.dateReviewed.getTime()
);
const latest = newestFirst[0];
---

<Layout
  title="Receipts — Saturday Boring Cereal"
  description="Every review on record, set as the small print nobody reads."
>
  <PageHeader
    kicker="Keep this for your records"
    title="The "
    accent="Receipts"
    lede="Every review on file, newest first, set as the small print nobody reads. Each entry lists what one person thought, and what the side panel actually said."
  />

  <Disclaimer
    cereals={newestFirst}
    title="Full record"
    sub={`${cereals.length} boxes · Latest reviewed ${shortDate(latest.data.dateReviewed)}`}
    showCta={false}
  />
</Layout>
