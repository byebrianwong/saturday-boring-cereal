---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { scoreCereal, gradeColorTier, overallOutOfTen } from '../lib/score';
import { u } from '../lib/url';

const cereals = await getCollection('cereals');
const ranked = [...cereals].sort((a, b) => (b.data.rating ?? -1) - (a.data.rating ?? -1));

// Compact payload for the client picker + table.
const items = ranked.map((c) => {
  const s = scoreCereal(c);
  return {
  id: c.id,
  brand: c.data.brand,
  name: c.data.name,
  emoji: c.data.emoji,
  boxColor: c.data.boxColor,
  boxImage: c.data.boxImage ? u(c.data.boxImage) : null,
  rating: c.data.rating,
  href: u(`/cereals/${c.id}/`),
  // Overall grade, precomputed so the client table can stamp it per column.
  overall: s.overall,
  grade: s.grade,
  tier: s.grade == null ? 'na' : gradeColorTier(s.grade),
  out10: s.overall == null ? null : overallOutOfTen(s.overall),
  n: {
    servingSize: c.data.nutrition.servingSize,
    calories: c.data.nutrition.calories ?? null,
    protein: c.data.nutrition.protein ?? null,
    totalSugars: c.data.nutrition.totalSugars ?? null,
    addedSugars: c.data.nutrition.addedSugars ?? null,
    dietaryFiber: c.data.nutrition.dietaryFiber ?? null,
    totalFat: c.data.nutrition.totalFat ?? null,
    saturatedFat: c.data.nutrition.saturatedFat ?? null,
    sodium: c.data.nutrition.sodium ?? null,
  },
  };
});
---

<Layout title="Price Check — Saturday Boring Cereal" description="Compare cereals side by side, scanned at the register.">
  <!-- ============ THE AD BREAK ============ -->
  <section class="head">
    <div class="rays"></div>
    <div class="rays-fine"></div>

    <div class="wrap head-in">
      <div class="section-kicker">Four boxes · One register · No waiting</div>
      <h1 class="head-title">Price <em>Check</em></h1>
      <p class="head-lede">
        Scan up to four boxes and put them side by side. The figures come off the side panel of the
        physical box, so they are as exciting as the side panel of a physical box.
      </p>
    </div>
  </section>

  <!-- ============ THE PICKER ============ -->
  <section class="pick">
    <div class="wrap">
      <div class="rowlabel">Tap a box to put it on the belt · Maximum four</div>
      <div class="picker" id="picker"></div>
    </div>
  </section>

  <!-- ============ THE BELT — loud frame, calm contents ============ -->
  <section class="belt">
    <div class="wrap">
      <div class="panel">
        <div class="panel-head">Side by side</div>

        <div class="board tbl-scroll" id="board">
          <div class="empty" id="empty">
            <span class="empty-burst starburst">0</span>
            <p>Nothing scanned. Tap a box above to add it to the belt.</p>
          </div>
        </div>

        <p class="board-foot">
          Per the serving size stated on each box, which is not the same serving size on every box.
          A star marks the best figure in a row, and only when two or more boxes list it and one of
          them wins outright. Where a label omits a value we say “not listed” rather than making one
          up.
        </p>
      </div>
    </div>
  </section>

  <script is:inline id="cereal-data" type="application/json" set:html={JSON.stringify(items)}></script>

  <script>
    interface Row {
      id: string; brand: string; name: string; emoji: string;
      boxColor: string; boxImage: string | null; rating: number | null; href: string;
      overall: number | null; grade: string | null; tier: string; out10: string | null;
      n: Record<string, number | null>;
    }
    const data: Row[] = JSON.parse(document.getElementById('cereal-data')!.textContent!);
    const picker = document.getElementById('picker')!;
    const board = document.getElementById('board')!;
    const empty = document.getElementById('empty')!;
    const MAX = 4;
    const selected = new Set<string>();

    // Deep-link support: /compare?ids=a,b,c — capped at MAX, same as the picker,
    // so a hand-written URL can't put five columns on a four-column belt.
    const initial = new URLSearchParams(location.search).get('ids');
    if (initial) {
      for (const id of initial.split(',')) {
        if (selected.size >= MAX) break;
        if (data.some((d) => d.id === id)) selected.add(id);
      }
    }

    // Missing data stays missing. `nil-note` is the site-wide "not listed" look.
    const nil = '<span class="na nil-note">not listed</span>';
    const g = (v: number | null) => (v == null ? nil : `${v}g`);
    const mg = (v: number | null) => (v == null ? nil : `${v}mg`);
    const plain = (v: number | null) => (v == null ? nil : String(v));

    // Which direction is "better" for the best-in-row star.
    const METRICS: Array<{ key: string; label: string; fmt: (v: number | null) => string; best?: 'max' | 'min' }> = [
      { key: 'servingSize', label: 'Serving', fmt: g },
      { key: 'calories', label: 'Calories', fmt: plain, best: 'min' },
      { key: 'protein', label: 'Protein', fmt: g, best: 'max' },
      { key: 'totalSugars', label: 'Total sugars', fmt: g, best: 'min' },
      { key: 'addedSugars', label: 'Added sugars', fmt: g, best: 'min' },
      { key: 'dietaryFiber', label: 'Fiber', fmt: g, best: 'max' },
      { key: 'totalFat', label: 'Total fat', fmt: g },
      { key: 'saturatedFat', label: 'Saturated fat', fmt: g },
      { key: 'sodium', label: 'Sodium', fmt: mg, best: 'min' },
    ];

    function bestId(key: string, dir: 'max' | 'min', chosen: Row[]): string | null {
      const vals = chosen
        .map((c) => ({ id: c.id, v: c.n[key] }))
        .filter((x): x is { id: string; v: number } => x.v != null);
      if (vals.length < 2) return null; // no point crowning a winner of one
      const target = dir === 'max' ? Math.max(...vals.map((x) => x.v)) : Math.min(...vals.map((x) => x.v));
      const winners = vals.filter((x) => x.v === target);
      return winners.length === 1 ? winners[0].id : null; // no star on ties
    }

    function renderPicker() {
      picker.innerHTML = '';
      for (const d of data) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'chip' + (selected.has(d.id) ? ' on' : '');
        b.disabled = !selected.has(d.id) && selected.size >= MAX;
        b.innerHTML = `<span class="cb">${d.boxImage ? `<img src="${d.boxImage}" alt="">` : d.emoji}</span>` +
          `<span class="ct"><b>${d.name}</b><small>${d.brand}</small></span>`;
        b.addEventListener('click', () => {
          if (selected.has(d.id)) selected.delete(d.id);
          else if (selected.size < MAX) selected.add(d.id);
          sync();
        });
        picker.appendChild(b);
      }
    }

    function renderBoard() {
      const chosen = data.filter((d) => selected.has(d.id));
      if (!chosen.length) {
        empty.style.display = '';
        // remove any table
        board.querySelector('.compare')?.remove();
        return;
      }
      empty.style.display = 'none';
      board.querySelector('.compare')?.remove();

      const winners: Record<string, string | null> = {};
      for (const m of METRICS) if (m.best) winners[m.key] = bestId(m.key, m.best, chosen);

      // Best overall grade among the chosen (needs 2+ graded; no star on a tie).
      let gradeWinner: string | null = null;
      const graded = chosen.filter((c): c is Row & { overall: number } => c.overall != null);
      if (graded.length >= 2) {
        const top = Math.max(...graded.map((c) => c.overall));
        const tops = graded.filter((c) => c.overall === top);
        if (tops.length === 1) gradeWinner = tops[0].id;
      }

      const el = document.createElement('div');
      el.className = 'compare';
      el.style.setProperty('--cols', String(chosen.length));
      el.innerHTML =
        `<div class="cgrid" style="grid-template-columns: var(--lab) repeat(${chosen.length}, minmax(0, 1fr))">` +
        // header row: box + name + rating
        `<div class="rh corner"></div>` +
        chosen.map((c) => `
          <div class="chead">
            <a class="box" href="${c.href}" style="--bc:${c.boxColor}">
              ${c.boxImage ? `<img src="${c.boxImage}" alt="${c.brand} ${c.name}">` : `<span class="e">${c.emoji}</span>`}
            </a>
            <div class="cn"><b>${c.name}</b><small>${c.brand}</small></div>
            <div class="crate">${
              c.rating == null ? nil : `${c.rating.toFixed(1)}<small>/10</small>`
            }</div>
            <button class="drop" data-id="${c.id}" title="Remove ${c.brand} ${c.name}" aria-label="Remove ${c.brand} ${c.name}">✕</button>
          </div>`).join('') +
        // overall grade row — the headline, stamped per column
        `<div class="rh grade-rh">Overall grade</div>` +
        chosen.map((c) => {
          const win = gradeWinner === c.id;
          const stamp = c.grade == null
            ? `<span class="gstamp na">—<small>unrated</small></span>`
            : `<span class="gstamp ${c.tier}">${c.grade}<small>${c.out10} / 10</small></span>`;
          return `<div class="cell grade-cell${win ? ' win' : ''}">${stamp}${win ? '<span class="star">★</span>' : ''}</div>`;
        }).join('') +
        // metric rows
        METRICS.map((m) => `
          <div class="rh">${m.label}</div>` +
          chosen.map((c) => {
            const win = m.best && winners[m.key] === c.id;
            return `<div class="cell${win ? ' win' : ''}">${m.fmt(c.n[m.key])}${win ? '<span class="star">★</span>' : ''}</div>`;
          }).join('')
        ).join('') +
        `</div>`;
      board.appendChild(el);
      el.querySelectorAll<HTMLButtonElement>('.drop').forEach((btn) =>
        btn.addEventListener('click', () => { selected.delete(btn.dataset.id!); sync(); })
      );
    }

    function sync() {
      const ids = [...selected];
      const url = ids.length ? `?ids=${ids.join(',')}` : location.pathname;
      history.replaceState(null, '', url);
      renderPicker();
      renderBoard();
    }

    renderPicker();
    renderBoard();
  </script>
</Layout>

<style>
  /* ---- the ad break ----
     All the volume on this page lives up here, so the table underneath can
     stay completely uninterested in itself. */

  .head {
    position: relative;
    overflow: hidden;
    background: var(--orange);
    border-bottom: 6px solid var(--ink);
    padding: 48px 0 44px;
    text-align: center;
  }

  .head .rays { top: 50%; }
  .head .rays-fine { top: 50%; }
  .head-in { position: relative; z-index: 3; }

  .head-title {
    margin: 16px 0 0;
    font-family: var(--shout);
    font-size: clamp(46px, 9vw, 104px);
    line-height: 0.82;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--white);
    text-shadow: 6px 6px 0 var(--ink);
  }

  /* The stroke fattens the glyphs, so the word space needs help to survive. */
  .head-title em {
    font-style: normal;
    margin-left: 0.09em;
    color: var(--yellow);
    -webkit-text-stroke: 3px var(--ink);
    text-shadow: 6px 6px 0 var(--cherry);
  }

  /* Framing copy is allowed to be readable; it just isn't allowed to shout. */
  .head-lede {
    max-width: 680px;
    margin: 24px auto 0;
    font-family: var(--fine);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
    background: rgba(255, 248, 234, 0.94);
    border: 3px solid var(--ink);
    padding: 12px 20px;
    text-align: left;
  }

  /* ---- picker ---- */

  .pick { padding: 34px 0 0; }

  .picker {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 14px auto 0;
    max-width: 1060px;
  }

  /* Chips are furniture, not data — they get the hard border and the shadow. */
  .picker :global(.chip) {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--white);
    border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    padding: 6px 14px 5px 6px;
    cursor: pointer;
    text-align: left;
    color: var(--ink);
    transition: transform 0.08s, box-shadow 0.08s, background 0.08s;
  }

  .picker :global(.chip:hover:not(:disabled)) {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ink);
  }

  .picker :global(.chip.on) {
    background: var(--yellow);
    box-shadow: 4px 4px 0 var(--cherry);
  }

  .picker :global(.chip:disabled) {
    opacity: 0.42;
    cursor: not-allowed;
    box-shadow: none;
    transform: translate(4px, 4px);
  }

  .picker :global(.chip .cb) {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    overflow: hidden;
    background: var(--cream);
    border: 2px solid var(--ink);
    flex: 0 0 30px;
  }

  .picker :global(.chip .cb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .picker :global(.chip .ct) {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .picker :global(.chip .ct b) {
    font-family: var(--shout);
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-weight: normal;
  }

  .picker :global(.chip .ct small) {
    font-family: var(--fine);
    font-size: 9px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-top: 3px;
  }

  /* ---- the belt ---- */

  .belt { padding: 26px 0 62px; }
  .belt .panel { max-width: 1080px; margin: 0 auto; }

  .board { margin-top: 2px; }

  .empty {
    text-align: center;
    padding: 26px 10px 20px;
  }

  .empty-burst {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 92px;
    height: 92px;
    background: var(--yellow);
    font-family: var(--shout);
    font-size: 40px;
    color: var(--cherry);
    line-height: 1;
  }

  .empty p {
    font-family: var(--fine);
    font-size: 14px;
    color: var(--muted);
    margin-top: 16px;
    letter-spacing: 0.02em;
  }

  /* ---- the comparison grid ----
     This is the punchline: after all that noise, a plain table. Small type,
     roomy rows, hairline rules, tabular figures. Nothing here is excited. */

  .board :global(.cgrid) {
    --lab: 150px;
    display: grid;
    min-width: 540px;
    background: var(--white);
  }

  /* Column head is a flex column so the taste score sits on a shared baseline
     however many lines the product name takes. */
  .board :global(.chead) {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 4px 10px 14px;
    text-align: center;
    border-bottom: 3px solid var(--ink);
  }

  /* The corner is a spacer, not a row label — it carries the header rule only.
     Specificity has to beat `.rh`, which sets a hairline border-top. */
  .board :global(.rh.corner) {
    background: transparent;
    border-top: 0;
    border-bottom: 3px solid var(--ink);
  }

  .board :global(.box) {
    width: 66px;
    height: 86px;
    margin: 0 auto 9px;
    border: 3px solid var(--ink);
    overflow: hidden;
    background: var(--bc, var(--cream));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .board :global(.box img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .board :global(.box .e) { font-size: 32px; }

  .board :global(.cn b) {
    display: block;
    font-family: var(--fine);
    font-size: 13px;
    font-weight: bold;
    line-height: 1.2;
    color: var(--ink);
  }

  .board :global(.cn small) {
    display: block;
    font-family: var(--fine);
    font-size: 9px;
    color: var(--muted-light);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-top: 3px;
  }

  /* The taste score is a number, so it behaves like one. */
  .board :global(.crate) {
    font-family: var(--fine);
    font-size: 15px;
    color: var(--ink-soft);
    margin-top: auto;
    padding-top: 7px;
    font-variant-numeric: tabular-nums;
  }

  .board :global(.crate small) {
    font-size: 10px;
    color: var(--muted-light);
    letter-spacing: 0.06em;
  }

  .board :global(.drop) {
    position: absolute;
    top: 0;
    right: 0;
    width: 20px;
    height: 20px;
    border: 2px solid var(--ink);
    background: var(--white);
    color: var(--ink);
    font-family: var(--fine);
    font-size: 10px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }

  .board :global(.drop:hover) { background: var(--cherry); color: var(--white); }

  .board :global(.rh) {
    display: flex;
    align-items: center;
    padding: 13px 12px;
    font-family: var(--fine);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-light);
    border-top: 1px solid var(--rule);
  }

  .board :global(.cell) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 13px 12px;
    font-family: var(--fine);
    font-size: 14px;
    color: var(--ink-soft);
    text-align: center;
    border-top: 1px solid var(--rule);
    font-variant-numeric: tabular-nums;
  }

  /* Best-in-row: a tint and a small mark. Not a celebration. */
  .board :global(.cell.win) { background: #fff6da; }
  .board :global(.cell .star) { color: var(--orange); font-size: 11px; }
  .board :global(.cell .na) { font-size: 12.5px; }

  .board :global(.grade-rh) {
    color: var(--ink);
    font-weight: bold;
  }

  .board :global(.grade-cell) { padding: 11px 12px; }

  /* Flat blocks, no gloss: the colour is a band, not a trophy. */
  .board :global(.gstamp) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 46px;
    padding: 5px 8px 4px;
    border: 2px solid var(--ink);
    background: var(--muted-light);
    color: var(--white);
    font-family: var(--shout);
    font-size: 19px;
    line-height: 1;
  }

  .board :global(.gstamp small) {
    font-family: var(--fine);
    font-size: 8.5px;
    font-weight: normal;
    letter-spacing: 0.06em;
    margin-top: 4px;
    font-variant-numeric: tabular-nums;
  }

  .board :global(.gstamp.elite) { background: var(--turq); }
  .board :global(.gstamp.good) { background: var(--score-good); }
  .board :global(.gstamp.mid) { background: var(--score-mid); color: var(--ink); }
  .board :global(.gstamp.bad) { background: var(--score-bad); }
  .board :global(.gstamp.na) { background: var(--muted); font-size: 15px; }

  .board-foot {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 3px solid var(--ink);
    font-family: var(--fine);
    font-size: 10.5px;
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--muted);
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .head { padding: 34px 0 32px; }
    .head-lede { font-size: 15px; }
    .belt .panel { padding: 16px 14px 14px; }
  }

  @media (max-width: 560px) {
    .board :global(.cgrid) { --lab: 108px; min-width: 460px; }
    .board :global(.rh) { padding: 12px 8px; letter-spacing: 0.1em; }
    .board :global(.cell) { padding: 12px 8px; }
    .picker :global(.chip) { box-shadow: 3px 3px 0 var(--ink); }
  }
</style>
