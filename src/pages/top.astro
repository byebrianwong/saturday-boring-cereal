---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { byRatingDesc } from '../lib/macros';
import { gramsShort } from '../lib/format';
import { scoreCereal } from '../lib/score';
import GradeStamp from '../components/GradeStamp.astro';
import PageHeader from '../components/PageHeader.astro';
import { u } from '../lib/url';

const cereals = await getCollection('cereals');
const ranked = [...cereals].sort(byRatingDesc);
const rated = ranked.filter((c) => c.data.rating != null);
const unrated = ranked.filter((c) => c.data.rating == null);

const scoreOf = new Map(ranked.map((c) => [c.id, scoreCereal(c)]));

const medal = ['gold', 'silver', 'bronze'];
---

<Layout
  title="The Rankings — Saturday Boring Cereal"
  description="Every cereal, ranked worst to best by one man's Taste score. The official chart."
>
  <PageHeader
    kicker="The official chart · Updated every Saturday"
    title="The "
    accent="Rankings"
    lede="Ranked by Taste, with each box's Overall grade — taste plus macros — stamped alongside. Unrated boxes sit at the bottom without a grade, because we will not invent a taste we never had."
  />

  <ol class="chart wrap">
    {
      rated.map((c, i) => (
        <li class:list={['row', { top: i < 3 }]}>
          <div class:list={['rank', medal[i]]}>{i + 1}</div>
          <a class="rowbox" href={u(`/cereals/${c.id}/`)} style={`--bc: ${c.data.boxColor}`}>
            {c.data.boxImage ? (
              <img src={u(c.data.boxImage)} alt={`${c.data.brand} ${c.data.name}`} loading="lazy" />
            ) : (
              <span class="e">{c.data.emoji}</span>
            )}
          </a>
          <div class="who">
            <a href={u(`/cereals/${c.id}/`)}>{c.data.name}</a>
            <small>{c.data.brand}</small>
          </div>
          <div class="meter">
            <div class="bar" style={`width: ${(c.data.rating! / 10) * 100}%`}></div>
            <span class="rowscore">{c.data.rating!.toFixed(1)}</span>
          </div>
          <GradeStamp grade={scoreOf.get(c.id)!.grade} overall={scoreOf.get(c.id)!.overall} size="sm" />
          <div class="rowmacros">
            {gramsShort(c.data.nutrition.protein) && <span><b>{gramsShort(c.data.nutrition.protein)}</b> pro</span>}
            {gramsShort(c.data.nutrition.totalSugars) && <span><b>{gramsShort(c.data.nutrition.totalSugars)}</b> sug</span>}
          </div>
        </li>
      ))
    }
    {
      unrated.map((c) => (
        <li class="row unrated">
          <div class="rank">—</div>
          <a class="rowbox" href={u(`/cereals/${c.id}/`)} style={`--bc: ${c.data.boxColor}`}>
            {c.data.boxImage ? (
              <img src={u(c.data.boxImage)} alt={`${c.data.brand} ${c.data.name}`} loading="lazy" />
            ) : (
              <span class="e">{c.data.emoji}</span>
            )}
          </a>
          <div class="who">
            <a href={u(`/cereals/${c.id}/`)}>{c.data.name}</a>
            <small>{c.data.brand}</small>
          </div>
          <div class="meter"><span class="rowscore na">unrated</span></div>
          <GradeStamp grade={scoreOf.get(c.id)!.grade} overall={scoreOf.get(c.id)!.overall} size="sm" />
          <div class="rowmacros"></div>
        </li>
      ))
    }
  </ol>
</Layout>

<style>

  .chart {
    max-width: 720px;
    margin: 30px auto 60px;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .row {
    display: grid;
    grid-template-columns: 46px 56px 1fr 150px 44px auto;
    align-items: center;
    gap: 14px;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 10px 16px 10px 10px;
    box-shadow: 0 4px 0 rgba(91, 58, 30, 0.18);
  }

  .row.top {
    border-width: 3px;
    box-shadow: 0 6px 0 rgba(91, 58, 30, 0.25);
  }

  .rank {
    font-family: var(--shout);
    font-size: 26px;
    text-align: center;
    color: #b0a58c;
  }

  .rank.gold {
    color: #e0a400;
  }
  .rank.silver {
    color: #9aa0a6;
  }
  .rank.bronze {
    color: #c17a3a;
  }

  .rowbox {
    width: 44px;
    height: 56px;
    border: 2px solid var(--ink);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, var(--bc), color-mix(in srgb, var(--bc) 72%, #000));
  }

  .rowbox img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rowbox .e {
    font-size: 22px;
  }

  .who a {
    font-family: var(--shout);
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    display: block;
    line-height: 1.15;
  }

  .who a:hover {
    color: var(--cherry);
  }

  .who small {
    font-size: 10px;
    color: #8a6a45;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .meter {
    position: relative;
    height: 22px;
    background: var(--cream);
    border-radius: 999px;
    display: flex;
    align-items: center;
  }

  .bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background: linear-gradient(90deg, #e0662c, var(--cherry));
    border-radius: 999px;
    min-width: 20px;
  }

  /* Sits at the right end of the track, which is pale — so it has to be dark
     ink, not white. (It previously read as white-on-red only because the
     global .score component was leaking a cherry background onto it.) */
  .rowscore {
    position: relative;
    margin-left: auto;
    margin-right: 10px;
    font-family: var(--shout);
    font-size: 14px;
    color: var(--ink);
    z-index: 1;
  }

  .rowscore.na {
    color: var(--muted);
    text-shadow: none;
    font-family: var(--fine);
    font-style: italic;
    font-size: 12px;
    margin-left: 12px;
  }

  .rowmacros {
    display: flex;
    gap: 8px;
    font-family: var(--fine);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
  }

  .rowmacros b {
    color: var(--cherry);
  }

  .row.unrated {
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 34px 44px 1fr 44px auto;
    }

    .meter {
      display: none;
    }
  }
</style>
