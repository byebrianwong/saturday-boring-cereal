---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AisleFilters from '../../components/AisleFilters.astro';
import PageHeader from '../../components/PageHeader.astro';
import { byRatingDesc } from '../../lib/macros';
import { per100gOf } from '../../lib/nutrition';
import { scoreCereal, scoreTier, gradeColorTier, overallOutOfTen, macroTier, proteinDVOf } from '../../lib/score';
import type { MacroTintKey } from '../../lib/score';
import { oneDecimal } from '../../lib/format';
import { label } from '../../lib/taxonomy';
import { u } from '../../lib/url';

const cereals = await getCollection('cereals');
const ranked = [...cereals].sort(byRatingDesc);

// One row per box. Nutrition is per 100 g, like everywhere else on the site.
// A null stays null: the cell prints a dash and sorts to the bottom.
const rows = ranked.map((c) => {
  const d = c.data;
  const n = per100gOf(c);
  const s = scoreCereal(c);
  const taste = d.rating == null ? null : d.rating * 10;
  return {
    id: c.id,
    d,
    href: u(`/cereals/${c.id}/`),
    taste,
    tasteTier: taste == null ? 'na' : scoreTier(taste),
    // Health is the nutrition share of the Overall grade: the weighted mean of
    // the protein, sugar, fiber and saturated-fat subscores, 0–100. Shown out
    // of ten so it sits on the same scale as Taste.
    health: s.nutrition,
    healthTier: s.nutrition == null ? 'na' : scoreTier(s.nutrition),
    overall: s.overall,
    grade: s.grade,
    gradeTier: s.grade == null ? 'na' : gradeColorTier(s.grade),
    n,
    tags: [...d.formFactors, ...d.attributes],
  };
});

// Macro columns, in display order. The four nutrients the grade scores come
// first: the two good ones (protein, fiber), then the two bad ones (sugar,
// saturated fat). The rest follow, printed smaller and greyer because the
// grade ignores them. `low` marks columns where less is better, so the first
// click on the header sorts lowest first. `graded` columns also get a pale
// good/mid/bad background that agrees with the Health score.
const METRICS = [
  { key: 'protein', label: 'Protein', title: 'Protein', unit: 'g', low: false, graded: true },
  { key: 'dietaryFiber', label: 'Fiber', title: 'Dietary fiber', unit: 'g', low: false, graded: true },
  { key: 'totalSugars', label: 'Sugar', title: 'Total sugars', unit: 'g', low: true, graded: true },
  { key: 'saturatedFat', label: 'Sat fat', title: 'Saturated fat', unit: 'g', low: true, graded: true },
  { key: 'calories', label: 'Cal', title: 'Calories', unit: '', low: true, graded: false },
  { key: 'totalCarbs', label: 'Carbs', title: 'Total carbohydrate', unit: 'g', low: false, graded: false },
  { key: 'totalFat', label: 'Fat', title: 'Total fat', unit: 'g', low: true, graded: false },
  { key: 'sodium', label: 'Sodium', title: 'Sodium', unit: 'mg', low: true, graded: false },
] as const;

type MetricKey = (typeof METRICS)[number]['key'];
const GRADED_COUNT = METRICS.filter((m) => m.graded).length;

// Calories and sodium read as whole numbers; grams get one decimal.
function fmt(v: number | null | undefined, unit: string): string | null {
  if (v == null) return null;
  return unit === 'g' ? `${oneDecimal(v)}g` : `${Math.round(v)}${unit}`;
}

// HTML lowercases attribute names, so camelCase keys are written as kebab-case
// (data-s-total-carbs) and come back as camelCase through `dataset`.
const kebab = (k: string) => k.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);

// data-* values for sorting. Empty string means "not listed".
const sortVal = (v: number | null | undefined) => (v == null ? '' : String(v));
---

<Layout title="The Aisle — Saturday Boring Cereal">
  <PageHeader
    kicker="Everything in stock · No samples"
    title="The "
    accent="Aisle"
    lede="Every box on record, one row each. Sort by any column heading. Filter by type or search by name. Press + on up to four boxes to send them to the price check."
  />

  <AisleFilters mode="buttons" />

  <div class="controls wrap">
    <label class="finder">
      <span>Search</span>
      <input id="q" type="search" placeholder="Brand, name or note" autocomplete="off" />
    </label>
    <div class="count" id="count" aria-live="polite"></div>
  </div>

  <section class="shelf wrap">
    <div class="ledger-frame">
      <div class="ledger-scroll" tabindex="0" role="region" aria-label="All cereals, one per row">
        <table class="ledger" id="ledger">
          <colgroup>
            <col class="col-name" />
            <col span="3" />
            <col span={GRADED_COUNT} />
            <col span={METRICS.length - GRADED_COUNT} />
            <col class="col-type" />
            <col class="col-note" />
            <col />
          </colgroup>
          <thead>
            <tr class="groups">
              <th class="g-name" scope="col"></th>
              <th class="g-scores" colspan="3" scope="colgroup">Scores · out of 10</th>
              <th class="g-macros" colspan={GRADED_COUNT} scope="colgroup">Graded · per 100 g</th>
              <th class="g-minor" colspan={METRICS.length - GRADED_COUNT} scope="colgroup">Not graded</th>
              <th class="g-rest" colspan="3" scope="colgroup">On the box</th>
            </tr>
            <tr class="heads">
              <th class="h-name" scope="col" data-sort="name" data-first="asc">
                <button type="button">Cereal</button>
              </th>
              <th class="h-big h-taste" scope="col" data-sort="taste" data-first="desc">
                <button type="button">Taste</button>
              </th>
              <th class="h-big h-health" scope="col" data-sort="health" data-first="desc">
                <button type="button">Health</button>
              </th>
              <th class="h-grade" scope="col" data-sort="overall" data-first="desc">
                <button type="button">Grade</button>
              </th>
              {METRICS.map((m) => (
                <th class:list={['h-num', { minor: !m.graded }]} scope="col" data-sort={m.key} data-first={m.low ? 'asc' : 'desc'} title={m.title}>
                  <button type="button">{m.label}</button>
                </th>
              ))}
              <th class="h-plain" scope="col">Type</th>
              <th class="h-plain" scope="col">Note</th>
              <th class="h-plain h-cmp" scope="col" title="Add to the price check">Cmp</th>
            </tr>
          </thead>
          <tbody id="rows">
            {rows.map((r) => (
              <tr
                data-id={r.id}
                data-tags={r.tags.join(' ')}
                data-search={`${r.d.brand} ${r.d.name} ${r.d.shortNote ?? ''}`.toLowerCase()}
                data-s-name={`${r.d.brand} ${r.d.name}`.toLowerCase()}
                data-s-taste={sortVal(r.taste)}
                data-s-health={sortVal(r.health)}
                data-s-overall={sortVal(r.overall)}
                {...Object.fromEntries(
                  METRICS.map((m) => [`data-s-${kebab(m.key)}`, sortVal(r.n[m.key as MetricKey])])
                )}
              >
                <th class="c-name" scope="row">
                  <a href={r.href}>
                    <span class="thumb" style={`--bc: ${r.d.boxColor}`}>
                      {r.d.boxImage ? (
                        <img src={u(r.d.boxImage)} alt="" loading="lazy" />
                      ) : (
                        <span class="e" aria-hidden="true">{r.d.emoji}</span>
                      )}
                    </span>
                    <span class="nm">
                      <b>{r.d.name}</b>
                      <small>{r.d.brand}</small>
                    </span>
                  </a>
                </th>
                <td class="c-big">
                  {r.taste == null ? (
                    <span class="big na" title="No Taste score on file">—</span>
                  ) : (
                    <span class={`big ${r.tasteTier}`}>{(r.taste / 10).toFixed(1)}</span>
                  )}
                </td>
                <td class="c-big">
                  {r.health == null ? (
                    <span class="big na" title="The label lists no protein, sugar, fiber or saturated fat">—</span>
                  ) : (
                    <span class={`big ${r.healthTier}`}>{(r.health / 10).toFixed(1)}</span>
                  )}
                </td>
                <td class="c-grade">
                  {r.grade == null ? (
                    <span class="seal na" title="Unrated boxes get no grade">—</span>
                  ) : (
                    <span class={`seal ${r.gradeTier}`} title={`Overall ${overallOutOfTen(r.overall!)} / 10`}>
                      {r.grade}
                    </span>
                  )}
                </td>
                {METRICS.map((m) => {
                  const raw = r.n[m.key as MetricKey];
                  const v = fmt(raw, m.unit);
                  // Protein is tinted by its %DV, the same number the grade uses.
                  const tintValue = m.key === 'protein' ? proteinDVOf(r.n).dv : raw;
                  const tier = m.graded ? macroTier(m.key as MacroTintKey, tintValue) : null;
                  return (
                    <td class:list={['c-num', { minor: !m.graded }, tier && `tint t-${tier}`]}>
                      {v ?? <span class="dash" title="Not listed on the label">—</span>}
                    </td>
                  );
                })}
                <td class="c-type">
                  {r.tags.length ? r.tags.map((t) => <span class="tg">{label(t)}</span>) : <span class="dash">—</span>}
                </td>
                <td class="c-note">
                  {r.d.shortNote ? r.d.shortNote : <span class="nil-note">No note on file.</span>}
                </td>
                <td class="c-cmp">
                  <button
                    class="addcmp"
                    type="button"
                    data-id={r.id}
                    aria-pressed="false"
                    aria-label={`Add ${r.d.brand} ${r.d.name} to the price check`}
                    title="Add to the price check"
                  >+</button>
                </td>
              </tr>
            ))}
            <tr class="none" id="none" hidden>
              <td colspan={METRICS.length + 7}>
                Out of stock. Nothing on this shelf matches. Try another aisle or a shorter search.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <p class="ledger-foot">
      Taste is one person’s score out of ten. Nutrition columns are per 100 g; a dash means the
      label doesn’t list it. <a href={u('/about/#overall')}>How scoring works</a>
    </p>
  </section>

  <div class="cart" id="cart" hidden>
    <span class="cartlabel">🛒 <b id="cartcount">0</b> in cart</span>
    <span class="carthint" id="carthint"></span>
    <a class="cartgo" id="cartgo" href={u('/compare/')}>PRICE CHECK →</a>
    <button class="cartclear" id="cartclear" type="button">clear</button>
  </div>
</Layout>

<script>
  const tbody = document.getElementById('rows')!;
  const none = document.getElementById('none')!;
  const count = document.getElementById('count')!;
  const q = document.getElementById('q') as HTMLInputElement;
  const filterBtns = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-filter-bar] [data-filter]')
  );
  const heads = Array.from(document.querySelectorAll<HTMLTableCellElement>('th[data-sort]'));
  const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-id]'));

  // State lives in the URL hash so a sorted, filtered view can be linked.
  // `f` is the aisle filter (the home page's aisle signs already link with it).
  const state = { f: 'all', s: 'taste', d: 'desc' as 'asc' | 'desc', q: '' };

  function readHash() {
    const h = new URLSearchParams(location.hash.slice(1));
    const f = h.get('f');
    if (f && filterBtns.some((b) => b.dataset.filter === f)) state.f = f;
    const s = h.get('s');
    if (s && heads.some((th) => th.dataset.sort === s)) state.s = s;
    const d = h.get('d');
    if (d === 'asc' || d === 'desc') state.d = d;
    else state.d = (heads.find((th) => th.dataset.sort === state.s)?.dataset.first as 'asc' | 'desc') ?? 'desc';
    state.q = h.get('q') ?? '';
    q.value = state.q;
  }

  function writeHash() {
    const h = new URLSearchParams();
    if (state.f !== 'all') h.set('f', state.f);
    if (state.s !== 'taste' || state.d !== 'desc') {
      h.set('s', state.s);
      h.set('d', state.d);
    }
    if (state.q) h.set('q', state.q);
    const str = h.toString();
    history.replaceState(null, '', str ? `#${str}` : location.pathname);
  }

  function matches(row: HTMLTableRowElement): boolean {
    if (state.f !== 'all' && !(row.dataset.tags ?? '').split(' ').includes(state.f)) return false;
    const terms = state.q.toLowerCase().trim().split(/\s+/).filter(Boolean);
    const hay = row.dataset.search ?? '';
    return terms.every((t) => hay.includes(t));
  }

  // Missing values always sort last, whichever way the column is sorted.
  function compare(a: HTMLTableRowElement, b: HTMLTableRowElement): number {
    const key = `s${state.s[0].toUpperCase()}${state.s.slice(1)}`;
    const av = a.dataset[key] ?? '';
    const bv = b.dataset[key] ?? '';
    if (av === '' && bv === '') return 0;
    if (av === '') return 1;
    if (bv === '') return -1;
    const dir = state.d === 'asc' ? 1 : -1;
    if (state.s === 'name') return dir * av.localeCompare(bv);
    return dir * (Number(av) - Number(bv));
  }

  function render() {
    let shown = 0;
    for (const row of rows) {
      const ok = matches(row);
      row.hidden = !ok;
      if (ok) shown++;
    }
    // Stable sort, with taste as the tie-break, so equal values keep a sensible order.
    const sorted = [...rows].sort((a, b) => compare(a, b) || Number(b.dataset.sTaste || -1) - Number(a.dataset.sTaste || -1));
    for (const row of sorted) tbody.insertBefore(row, none);
    none.hidden = shown > 0;
    count.textContent = `${shown} of ${rows.length} box${rows.length === 1 ? '' : 'es'} shown`;

    for (const th of heads) {
      const on = th.dataset.sort === state.s;
      th.classList.toggle('on', on);
      if (on) th.setAttribute('aria-sort', state.d === 'asc' ? 'ascending' : 'descending');
      else th.removeAttribute('aria-sort');
    }
    for (const b of filterBtns) b.classList.toggle('on', b.dataset.filter === state.f);
    writeHash();
  }

  for (const th of heads) {
    th.querySelector('button')!.addEventListener('click', () => {
      const key = th.dataset.sort!;
      if (state.s === key) state.d = state.d === 'asc' ? 'desc' : 'asc';
      else {
        state.s = key;
        state.d = (th.dataset.first as 'asc' | 'desc') ?? 'desc';
      }
      render();
    });
  }

  for (const b of filterBtns) {
    b.addEventListener('click', () => {
      state.f = b.dataset.filter!;
      render();
    });
  }

  q.addEventListener('input', () => {
    state.q = q.value;
    render();
  });

  readHash();
  render();
  // A link to another sort or filter on this same page only changes the hash.
  addEventListener('hashchange', () => {
    readHash();
    render();
  });

  // --- "add to compare" cart -> /compare?ids=... (max 4, matching the compare page) ---
  const CART_MAX = 4;
  const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
  const cart = document.getElementById('cart')!;
  const cartCount = document.getElementById('cartcount')!;
  const cartHint = document.getElementById('carthint')!;
  const cartGo = document.getElementById('cartgo') as HTMLAnchorElement;
  const cartClear = document.getElementById('cartclear')!;
  const addBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.addcmp'));
  const inCart = new Set<string>();

  function renderCart() {
    for (const b of addBtns) {
      const on = inCart.has(b.dataset.id!);
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
      b.textContent = on ? '✓' : '+';
      b.disabled = !on && inCart.size >= CART_MAX;
    }
    cart.hidden = inCart.size === 0;
    cartCount.textContent = String(inCart.size);
    cartHint.textContent = inCart.size >= CART_MAX ? '(max — clear one to swap)' : '';
    cartGo.href = inCart.size ? `${BASE}/compare/?ids=${[...inCart].join(',')}` : `${BASE}/compare/`;
  }

  for (const b of addBtns) {
    b.addEventListener('click', () => {
      const id = b.dataset.id!;
      if (inCart.has(id)) inCart.delete(id);
      else if (inCart.size < CART_MAX) inCart.add(id);
      renderCart();
    });
  }
  cartClear.addEventListener('click', () => { inCart.clear(); renderCart(); });
  renderCart();
</script>

<style>
  /* Class names here are page-local on purpose. Global names like .box,
     .score, .macros, .tags and .brand would pull in unset properties from
     global.css even when this page's rule wins. */

  .controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 22px;
    margin-top: 18px;
    flex-wrap: wrap;
  }

  /* The search box is furniture, so it gets the hard border and shadow. */
  .finder {
    display: flex;
    align-items: stretch;
    border: 3px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    background: var(--white);
  }

  .finder span {
    display: flex;
    align-items: center;
    background: var(--turq);
    color: var(--white);
    font-family: var(--shout);
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px 4px;
    border-right: 3px solid var(--ink);
  }

  .finder input {
    border: 0;
    font-family: var(--fine);
    font-size: 15px;
    color: var(--ink);
    padding: 8px 12px;
    width: 260px;
    background: transparent;
  }

  .finder input:focus { outline: none; }
  .finder:focus-within { outline: 4px solid var(--turq); outline-offset: 3px; }

  .count {
    font-family: var(--fine);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---- the ledger ----
     Loud frame, calm contents. The frame and the group bars carry the ad
     look; the cells are small, plain and tabular. Taste and Health are the
     one exception: they are the headline of each row, so they get the
     display face and a colour band. */

  /* The table needs more width than the 1280px page column. */
  .shelf { max-width: 1600px; margin: 26px auto 80px; }

  .ledger-frame {
    background: var(--white);
    border: 4px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
  }

  /* Wide tables scroll inside their own box, never the page. */
  .ledger-scroll { overflow-x: auto; }
  .ledger-scroll:focus-visible { outline-offset: -4px; }

  .ledger {
    width: 100%;
    min-width: 1180px;
    border-collapse: separate;
    border-spacing: 0;
    font-family: var(--fine);
    font-size: 14px;
    color: var(--ink-soft);
    text-align: left;
  }

  .col-name { width: 230px; }
  .col-type { width: 130px; }
  .col-note { width: 240px; }

  .ledger th,
  .ledger td {
    padding: 9px 7px;
    border-bottom: 1px solid var(--rule);
    vertical-align: middle;
    font-weight: normal;
  }

  /* Group bars: black strips with white caps, like the section kickers. */
  .groups th {
    background: var(--ink);
    color: var(--white);
    font-family: var(--fine);
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding: 6px 10px 5px;
    border-bottom: 0;
    text-align: center;
  }

  .groups .g-scores { background: var(--cherry); }
  .groups .g-minor { background: var(--muted); }
  .groups .g-name { background: var(--ink); }

  .heads th {
    background: var(--cream);
    border-bottom: 3px solid var(--ink);
    padding: 0;
    white-space: nowrap;
    vertical-align: bottom;
  }

  .heads th button {
    display: block;
    width: 100%;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .heads th button,
  .heads .h-plain {
    padding: 10px 7px 8px;
    font-family: var(--fine);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: inherit;
  }

  .heads .h-plain { text-align: left; }

  .heads th button:hover { color: var(--ink); background: #fff1c4; }

  /* Sort arrow: a small mark, shown only on the active column. */
  .heads th button::after {
    content: '';
    display: inline-block;
    width: 0.9em;
    text-align: left;
    padding-left: 2px;
  }

  .heads th.on button { color: var(--ink); background: var(--yellow); }
  .heads th[aria-sort='ascending'] button::after { content: '▲'; }
  .heads th[aria-sort='descending'] button::after { content: '▼'; }

  .h-num, .h-grade, .h-big { text-align: center; }

  /* Taste and Health headings are allowed to shout. */
  .heads .h-big button {
    font-family: var(--shout);
    font-size: 18px;
    letter-spacing: 0.04em;
    color: var(--ink);
    padding: 8px 6px 5px;
  }

  /* Sticky first column, so the name stays put while the macros scroll. */
  .h-name,
  .c-name {
    position: sticky;
    left: 0;
    z-index: 2;
    border-right: 3px solid var(--ink);
  }

  .g-name { position: sticky; left: 0; z-index: 2; border-right: 3px solid var(--ink); }
  /* Column widths in <colgroup> are only hints; this one has to hold. */
  .c-name { background: var(--white); min-width: 190px; padding-left: 10px; }

  tbody tr:hover td:not(.tint),
  tbody tr:hover .c-name { background: #fffaf0; }

  tbody tr:last-of-type td,
  tbody tr:last-of-type th { border-bottom: 0; }

  .c-name a {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }

  .thumb {
    flex: 0 0 34px;
    width: 34px;
    height: 44px;
    border: 2px solid var(--ink);
    background: var(--bc, var(--cream));
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb .e { font-size: 19px; line-height: 1; }

  .nm b {
    display: block;
    font-size: 14px;
    font-weight: bold;
    line-height: 1.2;
  }

  .nm small {
    display: block;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
    margin-top: 3px;
  }

  .c-name a:hover b { color: var(--cherry); text-decoration: underline; text-underline-offset: 3px; }

  /* ---- the two headline numbers ---- */

  .c-big { text-align: center; padding: 7px 8px; }

  .big {
    display: inline-block;
    min-width: 54px;
    padding: 6px 7px 3px;
    border: 3px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: var(--shout);
    font-size: 26px;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--white);
    background: var(--muted-light);
    font-variant-numeric: tabular-nums;
  }

  .big.good { background: var(--score-good); }
  .big.mid { background: var(--score-mid); color: var(--ink); }
  .big.bad { background: var(--score-bad); }
  .big.na { background: var(--cream); color: var(--muted-light); box-shadow: none; border-style: dashed; }

  /* The grade is a small flat seal: it summarises the two numbers beside it. */
