---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AisleFilters from '../../components/AisleFilters.astro';
import CategorySwitch from '../../components/CategorySwitch.astro';
import PageHeader from '../../components/PageHeader.astro';
import WrapperShot from '../../components/WrapperShot.astro';
import { byRatingDesc } from '../../lib/macros';
import { per100gOf, percentOfDay, type Nutrition } from '../../lib/nutrition';
import { scoreCereal, scoreTier, tierColor, overallOutOfTen, macroTier, proteinDVOf } from '../../lib/score';
import type { MacroTintKey } from '../../lib/score';
import { oneDecimal } from '../../lib/format';
import { AISLE_FILTERS, CATEGORY_ORDER, EVERYTHING_FILTERS, inCategory, inWrapper, label, productPath } from '../../lib/taxonomy';
import { u } from '../../lib/url';

const cereals = await getCollection('cereals');
const ranked = [...cereals].sort(byRatingDesc);

// Cereal, bars and snacks share this page, but each is ranked only within its
// own category. The page opens on cereal; the category row appears once
// anything else is in stock.
const counts = Object.fromEntries(CATEGORY_ORDER.map((c) => [c, inCategory(cereals, c).length])) as Record<
  (typeof CATEGORY_ORDER)[number],
  number
>;
const stocked = CATEGORY_ORDER.filter((c) => counts[c] > 0);
const showSwitch = stocked.length > 1;
// A bar or snack filter button only shows when something in that category
// carries the tag, so a short shelf doesn't fill up with buttons that find
// nothing. The cereal row is the site's original, fixed list and stays whole.
const tagsIn = (list: typeof cereals) =>
  new Set<string>(list.flatMap((c) => [...c.data.formFactors, ...c.data.attributes]));
const filtersFor = (keys: string[], list: typeof cereals) => {
  const present = tagsIn(list);
  return keys.filter((k) => k === 'all' || present.has(k));
};
const filterRows = [
  ...stocked.map((c) => ({
    category: c,
    keys: c === 'cereal' ? AISLE_FILTERS.cereal : filtersFor(AISLE_FILTERS[c], inCategory(cereals, c)),
  })),
  ...(showSwitch ? [{ category: 'all' as const, keys: filtersFor(EVERYTHING_FILTERS, cereals) }] : []),
];

// One row per box. Nutrition is per 100 g, like everywhere else on the site.
// A null stays null: the cell prints a dash and sorts to the bottom.
// `pos` is the first paint's position number, counted within the category.
const seen = new Map<string, number>();
const rows = ranked.map((c) => {
  const d = c.data;
  const n = per100gOf(c);
  const s = scoreCereal(c);
  const taste = d.rating == null ? null : d.rating * 10;
  const pos = seen.get(d.category) ?? 0;
  seen.set(d.category, pos + 1);
  return {
    id: c.id,
    d,
    pos,
    wrapped: inWrapper(c),
    href: u(productPath(c)),
    taste,
    tasteTier: taste == null ? 'na' : scoreTier(taste),
    // Health is the nutrition share of the Tier score: the weighted mean of
    // the protein, sugar, fiber and saturated-fat subscores, 0–100. Shown out
    // of ten so it sits on the same scale as Taste.
    health: s.nutrition,
    healthTier: s.nutrition == null ? 'na' : scoreTier(s.nutrition),
    overall: s.overall,
    tier: s.tier,
    tierColor: s.tier == null ? 'na' : tierColor(s.tier),
    n,
    tags: [...d.formFactors, ...d.attributes],
  };
});

// Macro columns, in display order. The four nutrients the Tier scores come
// first: the two good ones (protein, fiber), then the two bad ones (sugar,
// saturated fat). The rest follow, printed smaller and greyer because the
// Tier ignores them. `low` marks columns where less is better, so the first
// click on the header sorts lowest first. `scored` columns also get a pale
// good/mid/bad background that agrees with the Health score.
const METRICS = [
  { key: 'protein', label: 'Protein', title: 'Protein', unit: 'g', low: false, scored: true },
  { key: 'dietaryFiber', label: 'Fiber', title: 'Dietary fiber', unit: 'g', low: false, scored: true },
  { key: 'totalSugars', label: 'Sugar', title: 'Total sugars', unit: 'g', low: true, scored: true },
  { key: 'saturatedFat', label: 'Sat fat', title: 'Saturated fat', unit: 'g', low: true, scored: true },
  { key: 'calories', label: 'Cal', title: 'Calories', unit: '', low: true, scored: false },
  { key: 'totalCarbs', label: 'Carbs', title: 'Total carbohydrate', unit: 'g', low: false, scored: false },
  { key: 'totalFat', label: 'Fat', title: 'Total fat', unit: 'g', low: true, scored: false },
  { key: 'sodium', label: 'Sodium', title: 'Sodium', unit: 'mg', low: true, scored: false },
] as const;

type MetricKey = (typeof METRICS)[number]['key'];
const SCORED_COUNT = METRICS.filter((m) => m.scored).length;

// Calories and sodium read as whole numbers; grams get one decimal.
function fmt(v: number | null | undefined, unit: string): string | null {
  if (v == null) return null;
  return unit === 'g' ? `${oneDecimal(v)}g` : `${Math.round(v)}${unit}`;
}

type Metric = (typeof METRICS)[number];

// One nutrient cell, in both units. The page shows one and hides the other,
// and the Grams / % switch flips which. `pct` is the share of a day: protein
// uses its %DV (marked "~" when estimated from grams), everything else uses
// `percentOfDay`, which gives total sugars and calories a reference too.
// Both are null when the label leaves the nutrient out.
function amounts(n: Nutrition, m: Metric) {
  const raw = n[m.key];
  const day = m.key === 'protein' ? proteinDVOf(n) : { dv: percentOfDay(m.key, raw), estimated: false };
  const pct = raw == null ? null : day.dv;
  const est = m.key === 'protein' && day.estimated;
  const g = fmt(raw, m.unit);
  const p = pct == null ? null : `${est ? '~' : ''}${Math.round(pct)}%`;
  const amount = m.unit === '' ? `${g} kcal` : g;
  return {
    g,
    p,
    pct,
    title: g == null ? 'Not listed on the label' : `${m.title} per 100 g: ${amount}, ${p} of a day${est ? ' (estimated)' : ''}`,
  };
}

// HTML lowercases attribute names, so camelCase keys are written as kebab-case
// (data-s-total-carbs) and come back as camelCase through `dataset`.
const kebab = (k: string) => k.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);

// data-* values for sorting. Empty string means "not listed".
const sortVal = (v: number | null | undefined) => (v == null ? '' : String(v));

// The data-* attributes the page script filters and sorts on. Table rows and
// box tiles carry the same set, so one sort puts both views in the same order.
const dataAttrs = (r: (typeof rows)[number]) => ({
  'data-id': r.id,
  'data-cat': r.d.category,
  'data-tags': r.tags.join(' '),
  'data-search': `${r.d.brand} ${r.d.name} ${r.d.shortNote ?? ''}`.toLowerCase(),
  'data-s-name': `${r.d.brand} ${r.d.name}`.toLowerCase(),
  'data-s-taste': sortVal(r.taste),
  'data-s-health': sortVal(r.health),
  'data-s-overall': sortVal(r.overall),
  ...Object.fromEntries(METRICS.map((m) => [`data-s-${kebab(m.key)}`, sortVal(r.n[m.key as MetricKey])])),
  // The same nutrients as a percent of a day. The percent view sorts on these,
  // so protein sorts by %DV, the number its tint and the Health score use.
  ...Object.fromEntries(METRICS.map((m) => [`data-p-${kebab(m.key)}`, sortVal(amounts(r.n, m).pct)])),
});

// The Boxes view has no column headings to click, so it sorts from a menu.
// `first` is the direction a new pick starts in, the same as the headings.
const SORTS = [
  { key: 'taste', label: 'Taste', first: 'desc' },
  { key: 'health', label: 'Health', first: 'desc' },
  { key: 'overall', label: 'Tier', first: 'desc' },
  ...METRICS.map((m) => ({ key: m.key, label: m.title, first: m.low ? 'asc' : 'desc' })),
  { key: 'name', label: 'Name', first: 'asc' },
];

// A tile prints only the four nutrients the Tier scores.
const TILE_METRICS = METRICS.filter((m) => m.scored);

// Position numbers for the first paint, which is sorted by Taste. The script
// renumbers on every sort. Boxes with no Taste score get no number.
const MEDALS = ['m1', 'm2', 'm3'];
---

<Layout title="The Aisle — Saturday Boring Cereal">
  <PageHeader
    kicker="Everything in stock · No samples"
    title="The "
    accent="Aisle"
    lede="Every box on record. Look at them as boxes or read them as a table. Sort, filter by type or search by name. Press + on up to four boxes to send them to the price check."
  />

  {showSwitch && <CategorySwitch counts={counts} />}
  {
    filterRows.map((row, i) => (
      <AisleFilters mode="buttons" category={row.category} only={row.keys} hidden={i > 0} />
    ))
  }

  <div class="controls wrap">
    <div class="viewer" role="group" aria-label="View">
      <button type="button" data-view="boxes" class="on" aria-pressed="true">Boxes</button>
      <button type="button" data-view="table" aria-pressed="false">Table</button>
    </div>
    <div class="viewer" role="group" aria-label="Show nutrients as">
      <button type="button" data-units="pct" class="on" aria-pressed="true" title="Share of a day's worth, per 100 g">% of day</button>
      <button type="button" data-units="g" aria-pressed="false" title="Grams per 100 g, as on the label">Grams</button>
    </div>
    <label class="finder">
      <span>Search</span>
      <input id="q" type="search" placeholder="Brand, name or note" autocomplete="off" />
    </label>
    <div class="sorter" id="sorter">
      <label>
        <span>Sort</span>
        <select id="sortby">
          {SORTS.map((s) => <option value={s.key} data-first={s.first}>{s.label}</option>)}
        </select>
      </label>
      <button type="button" id="sortdir">Highest first</button>
    </div>
    <div class="count" id="count" aria-live="polite"></div>
  </div>

  <section class="shelf wrap" id="shelf" data-units="pct">
    <ol class="tiles" id="tiles" aria-label="All cereals, as boxes">
      {rows.map((r) => (
        <li class="tile" {...dataAttrs(r)} hidden={r.d.category !== 'cereal'}>
          <span class:list={['pos', MEDALS[r.pos]]} hidden={r.taste == null}>{r.pos + 1}</span>
          <a class="tile-link" href={r.href}>
            <span class:list={['tile-img', { wide: r.wrapped }]} style={`--bc: ${r.d.boxColor}`}>
              {r.wrapped ? (
                <WrapperShot image={r.d.boxImage} emoji={r.d.emoji} boxColor={r.d.boxColor} alt="" />
              ) : r.d.boxImage ? (
                <img src={u(r.d.boxImage)} alt="" loading="lazy" />
              ) : (
                <span class="e" aria-hidden="true">{r.d.emoji}</span>
              )}
            </span>
            <span class="tile-nm">
              <small>{r.d.brand}</small>
              <b>{r.d.name}</b>
            </span>
          </a>
          <div class="tile-scores">
            <span class="tsc">
              {r.taste == null ? (
                <span class="big na" title="No Taste score on file">—</span>
              ) : (
                <span class={`big ${r.tasteTier}`}>{(r.taste / 10).toFixed(1)}</span>
              )}
              <small>Taste</small>
            </span>
            <span class="tsc">
              {r.health == null ? (
                <span class="big na" title="The label lists no protein, sugar, fiber or saturated fat">—</span>
              ) : (
                <span class={`big ${r.healthTier}`}>{(r.health / 10).toFixed(1)}</span>
              )}
              <small>Health</small>
            </span>
            <span class="tsc">
              {r.tier == null ? (
                <span class="seal na" title="Unrated boxes get no tier">—</span>
              ) : (
                <span class={`seal ${r.tierColor}`} title={`Overall ${overallOutOfTen(r.overall!)} / 10`}>
                  {r.tier}
                </span>
              )}
              <small>Tier</small>
            </span>
          </div>
          <dl class="tile-macros">
            {TILE_METRICS.map((m) => {
              const raw = r.n[m.key as MetricKey];
              const tintValue = m.key === 'protein' ? proteinDVOf(r.n).dv : raw;
              const tier = macroTier(m.key as MacroTintKey, tintValue);
              const a = amounts(r.n, m);
              return (
                <div class:list={['tm', tier && `t-${tier}`]} title={a.title}>
                  <dt>{m.label}</dt>
                  <dd>
                    {a.g == null ? (
                      <span class="dash">—</span>
                    ) : (
                      <><span class="u-pct">{a.p}</span><span class="u-g">{a.g}</span></>
                    )}
                  </dd>
                </div>
              );
            })}
          </dl>
          <button
            class="addcmp"
            type="button"
            data-id={r.id}
            aria-pressed="false"
            aria-label={`Add ${r.d.brand} ${r.d.name} to the price check`}
            title="Add to the price check"
          >+</button>
        </li>
      ))}
      <li class="tile-none" id="tiles-none" hidden>
        Out of stock. Nothing on this shelf matches. Try another aisle or a shorter search.
      </li>
    </ol>

    <div class="ledger-frame" id="ledger-frame" hidden>
      <div class="ledger-scroll" tabindex="0" role="region" aria-label="All cereals, one per row">
        <table class="ledger" id="ledger">
          <colgroup>
            <col class="col-name" />
            <col span="3" />
            <col span={SCORED_COUNT} />
            <col span={METRICS.length - SCORED_COUNT} />
            <col class="col-type" />
            <col class="col-note" />
            <col />
          </colgroup>
          <thead>
            <tr class="groups">
              <th class="g-name" scope="col"></th>
              <th class="g-scores" colspan="3" scope="colgroup">Scores · out of 10</th>
              <th class="g-macros" colspan={SCORED_COUNT} scope="colgroup">
                <span class="u-pct">Scored · % of a day, per 100 g</span>
                <span class="u-g">Scored · grams per 100 g</span>
              </th>
              <th class="g-minor" colspan={METRICS.length - SCORED_COUNT} scope="colgroup">Not scored</th>
              <th class="g-rest" colspan="3" scope="colgroup">On the box</th>
            </tr>
            <tr class="heads">
              <th class="h-name" scope="col" data-sort="name" data-first="asc">
                <button type="button" id="name-head">Cereal</button>
              </th>
              <th class="h-big h-taste" scope="col" data-sort="taste" data-first="desc">
                <button type="button">Taste</button>
              </th>
              <th class="h-big h-health" scope="col" data-sort="health" data-first="desc">
                <button type="button">Health</button>
              </th>
              <th class="h-tier" scope="col" data-sort="overall" data-first="desc">
                <button type="button">Tier</button>
              </th>
              {METRICS.map((m) => (
                <th class:list={['h-num', { minor: !m.scored }]} scope="col" data-sort={m.key} data-first={m.low ? 'asc' : 'desc'} title={m.title}>
                  <button type="button">{m.label}</button>
                </th>
              ))}
              <th class="h-plain" scope="col">Type</th>
              <th class="h-plain" scope="col">Note</th>
              <th class="h-plain h-cmp" scope="col" title="Add to the price check">Cmp</th>
            </tr>
          </thead>
          <tbody id="rows">
            {rows.map((r) => (
              <tr {...dataAttrs(r)} hidden={r.d.category !== 'cereal'}>
                <th class="c-name" scope="row">
                  <a href={r.href}>
                    <span class:list={['thumb', { wide: r.wrapped }]} style={`--bc: ${r.d.boxColor}`}>
                      {r.wrapped ? (
                        <WrapperShot image={r.d.boxImage} emoji={r.d.emoji} boxColor={r.d.boxColor} alt="" size="xs" />
                      ) : r.d.boxImage ? (
                        <img src={u(r.d.boxImage)} alt="" loading="lazy" />
                      ) : (
                        <span class="e" aria-hidden="true">{r.d.emoji}</span>
                      )}
                    </span>
                    <span class="nm">
                      <b>{r.d.name}</b>
                      <small>{r.d.brand}</small>
                    </span>
                  </a>
                </th>
                <td class="c-big">
                  {r.taste == null ? (
                    <span class="big na" title="No Taste score on file">—</span>
                  ) : (
                    <span class={`big ${r.tasteTier}`}>{(r.taste / 10).toFixed(1)}</span>
                  )}
                </td>
                <td class="c-big">
                  {r.health == null ? (
                    <span class="big na" title="The label lists no protein, sugar, fiber or saturated fat">—</span>
                  ) : (
                    <span class={`big ${r.healthTier}`}>{(r.health / 10).toFixed(1)}</span>
                  )}
                </td>
                <td class="c-tier">
                  {r.tier == null ? (
                    <span class="seal na" title="Unrated boxes get no tier">—</span>
                  ) : (
                    <span class={`seal ${r.tierColor}`} title={`Overall ${overallOutOfTen(r.overall!)} / 10`}>
                      {r.tier}
                    </span>
                  )}
                </td>
                {METRICS.map((m) => {
                  const raw = r.n[m.key as MetricKey];
                  // Protein is tinted by its %DV, the same number the Tier score uses.
                  const tintValue = m.key === 'protein' ? proteinDVOf(r.n).dv : raw;
                  const tier = m.scored ? macroTier(m.key as MacroTintKey, tintValue) : null;
                  const a = amounts(r.n, m);
                  return (
                    <td class:list={['c-num', { minor: !m.scored }, tier && `tint t-${tier}`]} title={a.title}>
                      {a.g == null ? (
                        <span class="dash">—</span>
                      ) : (
                        <><span class="u-pct">{a.p}</span><span class="u-g">{a.g}</span></>
                      )}
                    </td>
                  );
                })}
                <td class="c-type">
                  {r.tags.length ? r.tags.map((t) => <span class="tg">{label(t)}</span>) : <span class="dash">—</span>}
                </td>
                <td class="c-note">
                  {r.d.shortNote ? r.d.shortNote : <span class="nil-note">No note on file.</span>}
                </td>
                <td class="c-cmp">
                  <button
                    class="addcmp"
                    type="button"
                    data-id={r.id}
                    aria-pressed="false"
                    aria-label={`Add ${r.d.brand} ${r.d.name} to the price check`}
                    title="Add to the price check"
                  >+</button>
                </td>
              </tr>
            ))}
            <tr class="none" id="none" hidden>
              <td colspan={METRICS.length + 7}>
                Out of stock. Nothing on this shelf matches. Try another aisle or a shorter search.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <p class="ledger-foot">
      Taste is my score out of ten. Nutrition columns are per 100 g; a dash means the
      label doesn’t list it. % of a day uses the FDA’s Daily Values for a 2,000-calorie diet. Total
      sugar has no Daily Value, so it is counted against 50 g, and calories against 2,000. ~ means
      the label prints no protein %DV, so it is estimated from grams.
      <a href={u('/about/#overall')}>How scoring works</a>
    </p>
  </section>

  <div class="cart" id="cart" hidden>
    <span class="cartlabel">🛒 <b id="cartcount">0</b> in cart</span>
    <span class="carthint" id="carthint"></span>
    <a class="cartgo" id="cartgo" href={u('/compare/')}>PRICE CHECK →</a>
    <button class="cartclear" id="cartclear" type="button">clear</button>
  </div>
</Layout>

<script>
  const tbody = document.getElementById('rows')!;
  const none = document.getElementById('none')!;
  const tilesEl = document.getElementById('tiles')!;
  const tilesNone = document.getElementById('tiles-none')!;
  const ledgerFrame = document.getElementById('ledger-frame')!;
  const sorter = document.getElementById('sorter')!;
  const sortBy = document.getElementById('sortby') as HTMLSelectElement;
  const sortDir = document.getElementById('sortdir') as HTMLButtonElement;
  const count = document.getElementById('count')!;
  const q = document.getElementById('q') as HTMLInputElement;
  const filterBars = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-bar]'));
  const catBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category]'));
  const nameHead = document.getElementById('name-head')!;
  const viewBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view]'));
  const shelf = document.getElementById('shelf')!;
  const unitBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-units]'));
  const heads = Array.from(document.querySelectorAll<HTMLTableCellElement>('th[data-sort]'));
  const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-id]'));
  const tiles = Array.from(tilesEl.querySelectorAll<HTMLLIElement>('li[data-id]'));

  type Dir = 'asc' | 'desc';
  type Units = 'pct' | 'g';

  // The Grams / % choice is also remembered in this browser, so it sticks
  // between visits. Storage can be blocked, so every access is guarded.
  const UNITS_KEY = 'aisle-units';
  function storedUnits(): Units {
    try {
      return localStorage.getItem(UNITS_KEY) === 'g' ? 'g' : 'pct';
    } catch {
      return 'pct';
    }
  }

  // The sort menu lists every sort key and the direction each one starts in.
  const options = Array.from(sortBy.options);
  const firstDir = (key: string): Dir => (options.find((o) => o.value === key)?.dataset.first as Dir) ?? 'desc';

  // State lives in the URL hash so a view, sort and filter can be linked.
  // `c` is the category: cereal (the default, never written), bar, snack or
  // all. Each category is ranked on its own, so it decides what the position
  // numbers count. Without the category row only cereal is valid.
  // `f` is the aisle filter, one of the buttons in that category's row.
  // `v` is the view; Boxes is the default, so only `v=table` is ever written.
  // `u` is the units; % of a day is the default, so only `u=g` is ever written.
  const state = { v: 'boxes' as 'boxes' | 'table', u: 'pct' as Units, c: 'cereal', f: 'all', s: 'taste', d: 'desc' as Dir, q: '' };

  // The filter buttons of the category on show.
  const barFor = (c: string) => filterBars.find((b) => b.dataset.filterBar === c);
  const filterBtnsIn = (c: string) =>
    Array.from(barFor(c)?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? []);

  // Nouns for the count line and the table's first heading.
  const NOUNS: Record<string, [string, string, string]> = {
    cereal: ['box', 'boxes', 'Cereal'],
    bar: ['bar', 'bars', 'Bar'],
    snack: ['snack', 'snacks', 'Snack'],
    all: ['product', 'products', 'Product'],
  };

  function readHash() {
    const h = new URLSearchParams(location.hash.slice(1));
    state.v = h.get('v') === 'table' ? 'table' : 'boxes';
    const units = h.get('u');
    state.u = units === 'g' || units === 'pct' ? units : storedUnits();
    const c = h.get('c');
    state.c = c && catBtns.some((b) => b.dataset.category === c) ? c : 'cereal';
    const f = h.get('f');
    state.f = f && filterBtnsIn(state.c).some((b) => b.dataset.filter === f) ? f : 'all';
    const s = h.get('s');
    state.s = s && options.some((o) => o.value === s) ? s : 'taste';
    const d = h.get('d');
    state.d = d === 'asc' || d === 'desc' ? d : firstDir(state.s);
    state.q = h.get('q') ?? '';
    q.value = state.q;
  }

  function writeHash() {
    const h = new URLSearchParams();
    if (state.v !== 'boxes') h.set('v', state.v);
    if (state.u !== 'pct') h.set('u', state.u);
    if (state.c !== 'cereal') h.set('c', state.c);
    if (state.f !== 'all') h.set('f', state.f);
    if (state.s !== 'taste' || state.d !== 'desc') {
      h.set('s', state.s);
      h.set('d', state.d);
    }
    if (state.q) h.set('q', state.q);
    const str = h.toString();
    history.replaceState(null, '', str ? `#${str}` : location.pathname);
  }

  // Nutrient columns carry two sort values: grams (data-s-*) and percent of a
  // day (data-p-*). Sort on the one being shown.
  function sortKey(): string {
    const name = `${state.s[0].toUpperCase()}${state.s.slice(1)}`;
    const hasPct = rows.length > 0 && `p${name}` in rows[0].dataset;
    return state.u === 'pct' && hasPct ? `p${name}` : `s${name}`;
  }

  function matches(el: HTMLElement): boolean {
    if (state.c !== 'all' && el.dataset.cat !== state.c) return false;
    if (state.f !== 'all' && !(el.dataset.tags ?? '').split(' ').includes(state.f)) return false;
    const terms = state.q.toLowerCase().trim().split(/\s+/).filter(Boolean);
    const hay = el.dataset.search ?? '';
    return terms.every((t) => hay.includes(t));
  }

  // Missing values always sort last, whichever way the column is sorted.
  function compare(a: HTMLElement, b: HTMLElement): number {
    const key = sortKey();
    const av = a.dataset[key] ?? '';
    const bv = b.dataset[key] ?? '';
    if (av === '' && bv === '') return 0;
    if (av === '') return 1;
    if (bv === '') return -1;
    const dir = state.d === 'asc' ? 1 : -1;
    if (state.s === 'name') return dir * av.localeCompare(bv);
    return dir * (Number(av) - Number(bv));
  }

  // Stable sort, with taste as the tie-break, so equal values keep a sensible order.
  const order = (a: HTMLElement, b: HTMLElement) =>
    compare(a, b) || Number(b.dataset.sTaste || -1) - Number(a.dataset.sTaste || -1);

  // Number the shown tiles in sort order. A box missing the sorted value gets
  // no number, and neither does any tile when sorting by name. The top three
  // get medal colours only when the sort runs best-first. Products are ranked
  // only within their own category, so a mixed shelf (Everything) gets none.
  function numberTiles(sorted: HTMLLIElement[]) {
    const key = sortKey();
    const ranked = state.s !== 'name' && state.c !== 'all';
    const bestFirst = state.d === firstDir(state.s);
    let pos = 0;
    for (const tile of sorted) {
      const chip = tile.querySelector<HTMLElement>('.pos')!;
      const numbered = ranked && !tile.hidden && (tile.dataset[key] ?? '') !== '';
      chip.hidden = !numbered;
      if (!numbered) continue;
      pos++;
      chip.textContent = String(pos);
      chip.classList.remove('m1', 'm2', 'm3');
      if (bestFirst && pos <= 3) chip.classList.add(`m${pos}`);
    }
  }

  function render() {
    let shown = 0;
    for (const el of [...rows, ...tiles]) el.hidden = !matches(el);
    for (const row of rows) if (!row.hidden) shown++;

    const sortedRows = [...rows].sort(order);
    for (const row of sortedRows) tbody.insertBefore(row, none);
    const sortedTiles = [...tiles].sort(order);
    for (const tile of sortedTiles) tilesEl.insertBefore(tile, tilesNone);
    numberTiles(sortedTiles);

    none.hidden = shown > 0;
    tilesNone.hidden = shown > 0;
    const inCat = state.c === 'all' ? rows.length : rows.filter((r) => r.dataset.cat === state.c).length;
    const [one, many, head] = NOUNS[state.c] ?? NOUNS.all;
    count.textContent = `${shown} of ${inCat} ${inCat === 1 ? one : many} shown`;
    nameHead.textContent = head;

    const boxes = state.v === 'boxes';
    tilesEl.hidden = !boxes;
    ledgerFrame.hidden = boxes;
    // The table sorts from its headings, so the menu only shows with the boxes.
    sorter.hidden = !boxes;
    for (const b of viewBtns) {
      const on = b.dataset.view === state.v;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    }
    shelf.dataset.units = state.u;
    for (const b of unitBtns) {
      const on = b.dataset.units === state.u;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    }

    sortBy.value = state.s;
    const asc = state.d === 'asc';
    sortDir.textContent = state.s === 'name' ? (asc ? 'A to Z' : 'Z to A') : asc ? 'Lowest first' : 'Highest first';

    for (const th of heads) {
      const on = th.dataset.sort === state.s;
      th.classList.toggle('on', on);
      if (on) th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
      else th.removeAttribute('aria-sort');
    }
    for (const bar of filterBars) bar.hidden = bar.dataset.filterBar !== state.c;
    for (const b of filterBtnsIn(state.c)) b.classList.toggle('on', b.dataset.filter === state.f);
    for (const b of catBtns) {
      const on = b.dataset.category === state.c;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    }
    writeHash();
  }

  function sortOn(key: string) {
    if (state.s === key) state.d = state.d === 'asc' ? 'desc' : 'asc';
    else {
      state.s = key;
      state.d = firstDir(key);
    }
    render();
  }

  for (const th of heads) {
    th.querySelector('button')!.addEventListener('click', () => sortOn(th.dataset.sort!));
  }

  sortBy.addEventListener('change', () => {
    state.s = sortBy.value;
    state.d = firstDir(state.s);
    render();
  });

  sortDir.addEventListener('click', () => {
    state.d = state.d === 'asc' ? 'desc' : 'asc';
    render();
  });

  for (const b of viewBtns) {
    b.addEventListener('click', () => {
      state.v = b.dataset.view as 'boxes' | 'table';
      render();
    });
  }

  for (const b of unitBtns) {
    b.addEventListener('click', () => {
      state.u = b.dataset.units as Units;
      try {
        localStorage.setItem(UNITS_KEY, state.u);
      } catch {
        // Blocked storage only means the choice isn't remembered.
      }
      render();
    });
  }

  for (const bar of filterBars) {
    for (const b of filterBtnsIn(bar.dataset.filterBar!)) {
      b.addEventListener('click', () => {
        state.f = b.dataset.filter!;
        render();
      });
    }
  }

  // A new category starts unfiltered: each category has its own filters.
  for (const b of catBtns) {
    b.addEventListener('click', () => {
      state.c = b.dataset.category!;
      state.f = 'all';
      render();
    });
  }

  q.addEventListener('input', () => {
    state.q = q.value;
    render();
  });

  readHash();
  render();
  // A link to another view, sort or filter on this same page only changes the hash.
  addEventListener('hashchange', () => {
    readHash();
    render();
  });

  // --- "add to compare" cart -> /compare?ids=... (max 4, matching the compare page) ---
  const CART_MAX = 4;
  const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
  const cart = document.getElementById('cart')!;
  const cartCount = document.getElementById('cartcount')!;
  const cartHint = document.getElementById('carthint')!;
  const cartGo = document.getElementById('cartgo') as HTMLAnchorElement;
  const cartClear = document.getElementById('cartclear')!;
  const addBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.addcmp'));
  const inCart = new Set<string>();

  function renderCart() {
    for (const b of addBtns) {
      const on = inCart.has(b.dataset.id!);
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
      b.textContent = on ? '✓' : '+';
      b.disabled = !on && inCart.size >= CART_MAX;
    }
    cart.hidden = inCart.size === 0;
    cartCount.textContent = String(inCart.size);
    cartHint.textContent = inCart.size >= CART_MAX ? '(max — clear one to swap)' : '';
    cartGo.href = inCart.size ? `${BASE}/compare/?ids=${[...inCart].join(',')}` : `${BASE}/compare/`;
  }

  for (const b of addBtns) {
    b.addEventListener('click', () => {
      const id = b.dataset.id!;
      if (inCart.has(id)) inCart.delete(id);
      else if (inCart.size < CART_MAX) inCart.add(id);
      renderCart();
    });
  }
  cartClear.addEventListener('click', () => { inCart.clear(); renderCart(); });
  renderCart();
</script>

