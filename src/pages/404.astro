---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { u } from '../lib/url';
---

<Layout title="Aisle Not Found — Saturday Boring Cereal">
  <PageHeader
    kicker="Not sold in stores · Not sold anywhere"
    title="We Don't "
    accent="Stock That"
    lede="You've wandered into an aisle that doesn't exist. It happens. The shelves here are finite, the milk is warm, and a stock clerk (one man) has been notified. The two links below go somewhere real."
  />

  <!-- The punchline: after all that shouting, a small sign and two plain links. -->
  <section class="oops">
    <div class="wrap oops-in">
      <div class="burst starburst" aria-hidden="true">
        <span class="in">
          Aisle
          <b>404</b>
          <em>Empty</em>
        </span>
      </div>

      <div class="panel oops-panel">
        <div class="panel-head">Somewhere that exists</div>
        <p class="plain">
          Nothing is broken at your end. The address just doesn't match anything on the shelf.
        </p>
        <div class="links">
          <a class="btn-ink" href={u('/')}>← Back to the front</a>
          <a class="btn-turq" href={u('/cereals/')}>Walk the aisle</a>
        </div>
      </div>

      <div class="rowlabel">Status 404 · Nothing was reserved, charged, or restocked</div>
    </div>
  </section>
</Layout>

<style>
  .oops {
    padding: 52px 0 68px;
      margin-bottom: 70px;
  }

  .oops-in {
    max-width: 660px;
    text-align: center;
  }

  /* The one loud object below the fold: a sold-out flash, tilted like a
     sticker somebody slapped on the shelf edge. */
  .burst {
    width: 168px;
    height: 168px;
    margin: 0 auto 30px;
    background: var(--yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-9deg);
  }

  .burst .in {
    font-family: var(--fine);
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.1;
  }

  .burst .in b {
    display: block;
    font-family: var(--shout);
    font-size: 52px;
    font-weight: normal;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--cherry);
    margin: 4px 0 3px;
  }

  .burst .in em {
    display: block;
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.26em;
  }

  .oops-panel {
    text-align: center;
  }

  .oops-panel .panel-head {
    text-align: left;
  }

  .oops-panel p {
    font-size: 15px;
    margin: 0 auto;
    max-width: 460px;
  }

  .links {
    margin-top: 24px;
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .oops { padding: 36px 0 48px; }
    .burst { width: 138px; height: 138px; }
    .burst .in b { font-size: 42px; }
    .links a { font-size: 18px; padding: 12px 22px 10px; }
  }
</style>
