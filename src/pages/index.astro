---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RankCard from '../components/RankCard.astro';
import ChampCard from '../components/ChampCard.astro';
import Disclaimer from '../components/Disclaimer.astro';
import BreakfastStrip from '../components/BreakfastStrip.astro';
import { byRatingDesc } from '../lib/macros';
import { label } from '../lib/taxonomy';
import { u } from '../lib/url';

const cereals = await getCollection('cereals');
const ranked = [...cereals].sort(byRatingDesc);
const champ = ranked[0];
const runnersUp = ranked.slice(1, 9);

// Tag counts for the "browse the aisles" section (form factors + attributes).
const tagCounts = new Map<string, number>();
for (const c of cereals) {
  for (const t of [...c.data.formFactors, ...c.data.attributes]) {
    tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
  }
}
const browseTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

// The "but wait, there's less" stats. Every one is derived from the real shelf
// so the boast is technically accurate, which is the joke.
const rated = cereals.filter((c) => c.data.rating != null);
const sugars = cereals.map((c) => c.data.nutrition.totalSugars).filter((v): v is number => v != null);
const proteins = cereals.map((c) => c.data.nutrition.protein).filter((v): v is number => v != null);
const topScore = Math.max(...rated.map((c) => c.data.rating as number));
const stats = [
  { n: String(cereals.length), k: 'Boxes on the record' },
  { n: sugars.length ? `${Math.min(...sugars)}g` : '—', k: 'Lowest sugar found' },
  { n: proteins.length ? `${Math.max(...proteins)}g` : '—', k: 'Highest protein found' },
  { n: topScore.toFixed(1), k: 'Top score awarded' },
];

const recent = [...cereals]
  .sort((a, b) => b.data.dateReviewed.getTime() - a.data.dateReviewed.getTime())
  .slice(0, 6);

// Tag chips cycle through the ad palette rather than encoding meaning.
const tagColour = ['y', 'o', 't', 'r', 'w'];
---

<Layout>
  <!-- ============ HERO — the ad spot ============ -->
  <section class="hero">
    <div class="rays rays-spin"></div>
    <div class="rays-fine"></div>

    <div class="wrap hero-inner">
      <div class="flash-eyebrow">★ As seen Saturday mornings ★</div>

      <div class="logo-lockup">
        <div class="l1">It’s the all-new</div>
        <div class="l2">Boring<br />Cereal</div>
        <div class="l3">Review-a-thon!</div>
      </div>

      <div class="tagline">“The only aisle where boring is a brag.”</div>

      <p class="subcopy">
        One man walks the healthy-cereal aisle so you don’t have to. Every box tasted, weighed, and
        priced in <strong>cold, hard macros.</strong> {cereals.length} boxes scored out of ten. A new
        one every Saturday, whether anybody asked or not.
      </p>

      <div class="cta-row">
        <a class="cta" href="#rankings">
          See all {cereals.length} scores
          <small>No spoon required</small>
        </a>
        <div class="offer-flash starburst">
          <div class="in">
            But wait<br />there’s<br />less!
            <em>Sugar, that is</em>
          </div>
        </div>
      </div>
    </div>

    <svg class="milk-splash" viewBox="0 0 1280 88" preserveAspectRatio="none" aria-hidden="true">
      <path
        fill="#ffffff"
        d="M0,44 C40,20 74,64 112,50 C150,36 168,72 210,60 C252,48 268,22 314,36
          C360,50 372,74 418,62 C464,50 480,26 528,38 C576,50 592,76 640,64 C688,52 700,24 748,36
          C796,48 812,74 860,62 C908,50 924,28 970,40 C1016,52 1032,76 1080,64 C1128,52 1146,26 1190,38
          C1226,48 1250,64 1280,50 L1280,88 L0,88 Z"
      />
      <circle cx="176" cy="30" r="9" fill="#fff" />
      <circle cx="392" cy="22" r="7" fill="#fff" />
      <circle cx="604" cy="28" r="10" fill="#fff" />
      <circle cx="836" cy="20" r="6.5" fill="#fff" />
      <circle cx="1048" cy="27" r="8.5" fill="#fff" />
      <circle cx="1232" cy="24" r="6" fill="#fff" />
    </svg>

    <BreakfastStrip />
  </section>

  <!-- ============ BUT WAIT, THERE'S LESS ============ -->
  <section class="butwait">
    <div class="rayband"></div>
    <div class="wrap butwait-in">
      <h2>But wait — there’s less!</h2>
      <p>
        Less sugar. Less marketing. Less pretending a 60-gram serving is 30 grams. Every box on this
        site is re-weighed on a kitchen scale and re-typed by hand, because the panel on the front of
        the box is an advert and the panel on the side is the truth.
      </p>
      <div class="lessgrid">
        {stats.map((s) => (
          <div class="lesscard">
            <div class="n">{s.n}</div>
            <div class="k">{s.k}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ RANKINGS ============ -->
  <section class="section" id="rankings">
    <div class="wrap">
      <div class="section-kicker">Now showing · The top {runnersUp.length + 1}</div>
      <h2 class="section-title">The <em>Scoreboard</em></h2>
      <p class="section-lede">
        Ranked #1 to #{runnersUp.length + 1} out of {cereals.length}. Score out of ten. Protein, sugar
        and serving size taken off the actual side panel — not off the front.
      </p>

      <div class="ranks">
        <ChampCard cereal={champ} />

        <div class="rank-row">
          {runnersUp.slice(0, 2).map((c, i) => <RankCard cereal={c} rank={i + 2} size="big" />)}
        </div>

        <div class="rank-row">
          {runnersUp.slice(2, 5).map((c, i) => <RankCard cereal={c} rank={i + 4} size="sm" />)}
        </div>

        <div class="rank-row">
          {runnersUp.slice(5, 8).map((c, i) => <RankCard cereal={c} rank={i + 7} size="sm" />)}
        </div>
      </div>

      <a class="btn-ink rank-more" href={u('/top/')}>See the full ranking →</a>
    </div>
  </section>

  <!-- ============ TAG AISLE ============ -->
  <section class="section section-dark">
    <div class="rayband"></div>
    <div class="wrap section-inner">
      <div class="section-kicker">Free with any visit</div>
      <h2 class="section-title">Browse the <em>aisles</em></h2>
      <p class="section-lede">Every box is filed under everything it honestly is. Nothing is filed under anything it isn’t.</p>

      <div class="tags">
        {browseTags.map(([tag, n], i) => (
          <a class={`tag ${tagColour[i % tagColour.length]}`} href={u(`/tags/${tag}/`)}>
            <span class="tc">{n}</span>
            <span class="tn">{label(tag)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ RECENT REVIEWS, AS ADVERT LEGALESE ============ -->
  <Disclaimer cereals={recent} />

  <!-- ============ SIGN-OFF ============ -->
  <section class="signoff">
    <div class="rays"></div>
    <div class="wrap signoff-in">
      <h2>New box every Saturday</h2>
      <p class="sub">
        No sponsors, no samples, no mascots. Just one person, one aisle, and a kitchen scale that has
        never once been asked to lie.
      </p>
      <a class="cta signoff-cta" href={u('/cereals/')}>
        Walk the aisle
        <small>Open 24/7 · Aisle 4 only</small>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* ---- hero ---- */
  .hero {
    position: relative;
    background: var(--orange);
    border-bottom: 6px solid var(--ink);
    overflow: hidden;
    padding: 64px 0 0;
    text-align: center;
  }

  .hero-inner { position: relative; z-index: 3; }

  .flash-eyebrow {
    display: inline-block;
    background: var(--ink);
    color: var(--yellow);
    font-family: var(--shout);
    font-size: clamp(14px, 2vw, 20px);
    letter-spacing: 0.3em;
    padding: 9px 26px 7px;
    text-transform: uppercase;
    transform: rotate(-1.2deg);
    animation: flashy 1.6s steps(1, end) infinite;
  }

  @keyframes flashy {
    0%, 60% { color: var(--yellow); }
    61%, 100% { color: var(--white); }
  }

  .logo-lockup { margin: 22px 0 0; }

  .logo-lockup .l1 {
    font-family: var(--shout);
    font-size: clamp(34px, 5.8vw, 74px);
    letter-spacing: 0.02em;
    color: var(--white);
    text-transform: uppercase;
    line-height: 0.82;
    text-shadow: 5px 5px 0 var(--ink);
  }

  .logo-lockup .l2 {
    font-family: var(--shout);
    font-size: clamp(64px, 12.4vw, 158px);
    line-height: 0.78;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--yellow);
    text-shadow: 6px 6px 0 var(--cherry), 12px 12px 0 var(--ink);
    -webkit-text-stroke: 3px var(--ink);
    margin: 6px 0 0;
  }

  .logo-lockup .l3 {
    font-family: var(--shout);
    font-size: clamp(34px, 5.8vw, 74px);
    letter-spacing: 0.06em;
    color: var(--white);
    text-transform: uppercase;
    line-height: 0.9;
    text-shadow: 5px 5px 0 var(--ink);
    margin-top: 4px;
  }

  .tagline {
    margin: 26px auto 0;
    display: inline-block;
    background: var(--turq);
    border: 5px solid var(--ink);
    box-shadow: 8px 8px 0 rgba(27, 18, 6, 0.85);
    color: var(--white);
    font-family: var(--shout);
    font-size: clamp(20px, 2.8vw, 33px);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 13px 30px 10px;
    transform: rotate(-0.8deg);
  }

  /* Body copy stays plain — the design shouts, the writing doesn't. */
  .subcopy {
    max-width: 760px;
    margin: 26px auto 0;
    font-family: var(--fine);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.5;
    color: var(--ink);
    background: rgba(255, 248, 234, 0.92);
    border: 3px solid var(--ink);
    padding: 14px 22px;
  }

  .subcopy strong { font-weight: bold; }

  .cta-row {
    margin: 30px 0 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
  }

  .offer-flash {
    width: 168px;
    height: 168px;
    background: var(--yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-13deg);
    flex: none;
  }

  .offer-flash .in {
    font-family: var(--shout);
    font-size: 25px;
    line-height: 0.9;
    color: var(--cherry);
    text-transform: uppercase;
    text-align: center;
    padding: 0 10px;
  }

  .offer-flash .in em {
    display: block;
    font-style: normal;
    font-size: 15px;
    color: var(--ink);
    letter-spacing: 0.08em;
    margin-top: 6px;
  }

  .milk-splash {
    position: relative;
    z-index: 3;
    margin-top: 34px;
    display: block;
    width: 100%;
    height: 88px;
  }

  /* ---- but wait ---- */
  .butwait {
    background: var(--turq);
    border-bottom: 6px solid var(--ink);
    padding: 34px 0 32px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .butwait-in { position: relative; z-index: 2; }

  .butwait h2 {
    margin: 0;
    font-family: var(--shout);
    font-size: clamp(34px, 5vw, 64px);
    line-height: 0.86;
    text-transform: uppercase;
    color: var(--yellow);
    -webkit-text-stroke: 3px var(--ink);
    text-shadow: 5px 5px 0 var(--ink);
  }

  .butwait p {
    margin: 16px auto 0;
    max-width: 800px;
    font-family: var(--fine);
    font-size: 17px;
    line-height: 1.5;
    color: #052f36;
    background: rgba(255, 255, 255, 0.9);
    border: 3px solid var(--ink);
    padding: 11px 20px;
  }

  .lessgrid {
    margin: 24px auto 0;
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .lesscard {
    background: var(--white);
    border: 4px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    padding: 14px 22px 12px;
    min-width: 184px;
  }

  .lesscard .n { font-family: var(--shout); font-size: 46px; line-height: 1; color: var(--cherry); }
  .lesscard .k {
    font-family: var(--fine);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #7c6c56;
    margin-top: 5px;
  }

  /* ---- rankings ---- */
  .ranks {
    margin-top: 46px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
  }

  .rank-row {
    display: flex;
    justify-content: center;
    gap: 26px;
    flex-wrap: wrap;
  }

  .rank-more { margin-top: 44px; }

  /* ---- signoff ---- */
  .signoff {
    position: relative;
    overflow: hidden;
    background: var(--orange);
    border-top: 6px solid var(--ink);
    padding: 52px 0 46px;
    text-align: center;
  }

  .signoff .rays { top: 50%; }
  .signoff-in { position: relative; z-index: 3; }

  .signoff h2 {
    margin: 0;
    font-family: var(--shout);
    font-size: clamp(36px, 5.5vw, 70px);
    line-height: 0.85;
    text-transform: uppercase;
    color: var(--white);
    text-shadow: 5px 5px 0 var(--ink);
  }

  .signoff .sub {
    margin: 14px auto 0;
    max-width: 620px;
    font-family: var(--fine);
    font-size: 16px;
    line-height: 1.5;
    background: rgba(255, 248, 234, 0.94);
    border: 3px solid var(--ink);
    padding: 11px 18px;
    color: var(--ink);
  }

  .signoff-cta { margin-top: 28px; }

  @media (max-width: 860px) {
    .hero { padding: 40px 0 0; }
    .offer-flash { width: 130px; height: 130px; }
    .offer-flash .in { font-size: 19px; }
    .offer-flash .in em { font-size: 12px; }
    .lesscard { min-width: 140px; padding: 11px 16px 9px; }
    .lesscard .n { font-size: 34px; }
  }
</style>
