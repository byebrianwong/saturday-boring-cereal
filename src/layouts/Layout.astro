---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import { u } from '../lib/url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

// Shelf size, shown in the ticker. Read here so every page's ticker stays
// truthful without each one having to pass the number down.
const count = (await getCollection('cereals')).length;

const {
  title = 'Saturday Boring Cereal',
  description = "One man's rankings of granolas and healthier cereals. Every box tasted, weighed, and priced in cold, hard macros.",
  image,
} = Astro.props;

// Absolute URLs for canonical + social cards. `site` is set in astro.config;
// update it to the real deploy URL so these resolve correctly in production.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// Per-page image (e.g. a cereal's box photo) or the default branded share card.
const ogImage = new URL(image ?? u('/og.png'), Astro.site ?? Astro.url).href;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Saturday Boring Cereal — Receipts" href={u('/rss.xml')} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🥣</text></svg>" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saturday Boring Cereal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <SiteHeader count={count} path={path} />

    <main>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
