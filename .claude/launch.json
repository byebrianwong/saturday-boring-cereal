{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astro-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npm run dev -- --port ${PORT:-4321}"],
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "storybook", "--", "--no-open"],
      "port": 6006
    }
  ]
}
